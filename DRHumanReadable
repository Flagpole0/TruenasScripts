def fmt_val(v, max_len=80):
    if v is None or v == "" or v == []:
        return "—"
    if isinstance(v, bool):
        return "Yes" if v else "No"
    if isinstance(v, dict):
        if "value" in v and "source" in v:
            return fmt_val(v["value"], max_len)
        if "parsed" in v and "rawvalue" in v:
            return fmt_val(v["parsed"], max_len)
        if len(v) <= 3:
            parts = [f"{k}: {fmt_val(val, 30)}" for k, val in v.items()]
            return " · ".join(parts)
        return f"[{len(v)} fields]"
    if isinstance(v, list):
        if all(isinstance(i, (str, int, float, bool)) for i in v):
            joined = ", ".join(str(i) for i in v)
            return joined[:max_len] + ("…" if len(joined) > max_len else "")
        if all(isinstance(i, dict) for i in v):
            return f"[{len(v)} items]"
        return str(v)[:max_len]
    s = str(v)
    return s[:max_len] + ("…" if len(s) > max_len else "")


def fmt_bytes(n):
    try:
        n = int(n)
    except (TypeError, ValueError):
        return str(n)
    for unit in ("B", "KB", "MB", "GB", "TB", "PB"):
        if abs(n) < 1024:
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} EB"


def pretty_key(k):
    return k.replace("_", " ").replace(".", " > ").title()


def pipe_escape(s):
    return str(s).replace("|", "\\|")


