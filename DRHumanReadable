def format_kv(data):
    if not isinstance(data, dict):
        return f"```\n{data}\n```\n"
    lines = ["| Setting | Value |", "| :--- | :--- |"]
    for k, v in data.items():
        if k.lower() in SKIP_KEYS:
            continue
        lines.append(f"| **{pipe_escape(pretty_key(k))}** | {pipe_escape(fmt_val(v))} |")
    return "\n".join(lines) + "\n"


def format_table(records):
    if not records or not isinstance(records[0], dict):
        return None
    headers = [k for k in records[0].keys() if k.lower() not in SKIP_KEYS]
    if not headers:
        headers = list(records[0].keys())
    lines = [
        "| " + " | ".join(pretty_key(h) for h in headers) + " |",
        "| " + " | ".join(":---" for _ in headers) + " |",
    ]
    for row in records:
        cells = [pipe_escape(fmt_val(row.get(h), 60)) for h in headers]
        lines.append("| " + " | ".join(cells) + " |")
    return "\n".join(lines) + "\n"


def format_cards(records):
    if not records:
        return None
    parts = []
    for i, row in enumerate(records):
        if not isinstance(row, dict):
            parts.append(f"- {row}")
            continue
        title = row.get("name") or row.get("id") or row.get("service") or f"Item {i+1}"
        parts.append(f"### {pipe_escape(fmt_val(title, 120))}\n")
        parts.append("| Setting | Value |")
        parts.append("| :--- | :--- |")
        for k, v in row.items():
            if k.lower() in SKIP_KEYS:
                continue
            parts.append(f"| **{pipe_escape(pretty_key(k))}** | {pipe_escape(fmt_val(v))} |")
        parts.append("")
    return "\n".join(parts) + "\n"


def format_auto(data):
    if isinstance(data, dict):
        return format_kv(data)
    if isinstance(data, list) and data:
        if isinstance(data[0], dict):
            sample = data[0]
            nested = sum(1 for v in sample.values() if isinstance(v, (dict, list)))
            if nested > len(sample) * 0.4:
                return format_cards(data)
            return format_table(data)
    return f"```\n{json.dumps(data, indent=2)}\n```\n"


def format_section(data, mode):
    if isinstance(data, list) and not data:
        return "*No entries configured.*\n"
    if mode == "kv":
        return format_kv(data)
    elif mode == "table":
        if isinstance(data, list) and data and isinstance(data[0], dict):
            return format_table(data) or format_auto(data)
        return format_kv(data) if isinstance(data, dict) else format_auto(data)
    elif mode == "cards":
        if isinstance(data, list) and data and isinstance(data[0], dict):
            return format_cards(data) or format_auto(data)
        return format_kv(data) if isinstance(data, dict) else format_auto(data)
    else:
        return format_auto(data)


