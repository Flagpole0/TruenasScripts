def appendix_iscsi_topology(session, base):
    """iSCSI relationship map: portals -> targets -> extents."""
    lines = ["## A5 — iSCSI Topology Map\n"]

    portals, _ = fetch(session, base, "/iscsi/portal")
    targets, _ = fetch(session, base, "/iscsi/target")
    extents, _ = fetch(session, base, "/iscsi/extent")
    maps, _ = fetch(session, base, "/iscsi/targetextent")
    initiators, _ = fetch(session, base, "/iscsi/initiator")

    if not targets:
        lines.append("*No iSCSI targets configured.*\n")
        return "\n".join(lines)

    portal_map = {}
    if portals:
        for p in portals:
            listen = p.get("listen", [])
            addrs = ", ".join(f"{l.get('ip','*')}:{l.get('port',3260)}" for l in listen) if listen else "—"
            portal_map[p.get("id")] = addrs

    extent_map = {}
    if extents:
        for e in extents:
            extent_map[e.get("id")] = {
                "name": e.get("name", "—"),
                "type": e.get("type", "—"),
                "path": e.get("path", e.get("disk", "—")),
                "enabled": e.get("enabled", True),
            }

    target_extents = defaultdict(list)
    if maps:
        for m in maps:
            eid = m.get("extent")
            ext = extent_map.get(eid, {"name": f"extent-{eid}", "type": "—", "path": "—"})
            target_extents[m.get("target")].append({"lun": m.get("lunid", "—"), **ext})

    initiator_map = {}
    if initiators:
        for ini in initiators:
            initiator_map[ini.get("id")] = {
                "comment": ini.get("comment", "—"),
                "initiators": ini.get("initiators", []),
            }

    for tgt in targets:
        tid = tgt.get("id")
        lines.append(f"### Target: {pipe_escape(tgt.get('name','—'))}\n")

        tgt_groups = tgt.get("groups", [])
        if tgt_groups:
            lines.append("**Portal / Initiator Groups:**\n")
            lines.append("| Portal | Listen Addresses | Initiator Group | Auth Method |")
            lines.append("| :--- | :--- | :--- | :--- |")
            for grp in tgt_groups:
                portal_id = grp.get("portal")
                init_id = grp.get("initiator")
                auth = grp.get("authmethod", "—")
                portal_addr = portal_map.get(portal_id, f"portal-{portal_id}")
                init_info = initiator_map.get(init_id, {"comment": f"group-{init_id}"})
                lines.append(
                    f"| {portal_id} | {pipe_escape(portal_addr)} "
                    f"| {pipe_escape(fmt_val(init_info.get('comment','—')))} "
                    f"| {auth} |"
                )
            lines.append("")

        texts = target_extents.get(tid, [])
        if texts:
            lines.append("**Mapped Extents:**\n")
            lines.append("| LUN | Extent Name | Type | Path / Device | Enabled |")
            lines.append("| :--- | :--- | :--- | :--- | :--- |")
            for ext in texts:
                lines.append(
                    f"| {ext.get('lun','—')} "
                    f"| {pipe_escape(ext.get('name','—'))} "
                    f"| {ext.get('type','—')} "
                    f"| {pipe_escape(fmt_val(ext.get('path','—'), 50))} "
                    f"| {'Yes' if ext.get('enabled') else 'No'} |"
                )
            lines.append("")
        else:
            lines.append("*No extents mapped to this target.*\n")

    return "\n".join(lines) + "\n"


