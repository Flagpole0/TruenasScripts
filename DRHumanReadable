    # ══════════════════════════════════════════════════════════════════════════
    #  Write output
    # ══════════════════════════════════════════════════════════════════════════
    md_path.write_text("\n".join(doc), encoding="utf-8")
    print(f"  ✓ Runbook saved → {md_path}")

    if not REDACT_ENABLED:
        print("  ⚠  OUTPUT CONTAINS PLAIN TEXT SECRETS — store securely")

    # Download config backup
    if DOWNLOAD_BACKUP:
        print("  Downloading config backup (with secret seed) ...")
