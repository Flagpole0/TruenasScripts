def scalar(ctx, table, col, default=""):
    if table not in ctx.tables or col not in [c for c, _ in ctx.cols(table)]:
        return default
    r = ctx.conn.execute(f"SELECT {qi(col)} FROM {qi(table)} LIMIT 1").fetchone()
    return default if r is None or r[0] is None else r[0]


def column(ctx, table, col):
    if table not in ctx.tables or col not in [c for c, _ in ctx.cols(table)]:
        return []
    return [r[0] for r in ctx.conn.execute(f"SELECT {qi(col)} FROM {qi(table)}") if r[0] is not None]


def hostname(ctx):
    h = clean(scalar(ctx, "network_globalconfiguration", "gc_hostname", "")) or "truenas"
    d = clean(scalar(ctx, "network_globalconfiguration", "gc_domain", ""))
    return h, (f"{h}.{d}" if d else h)


def safe_name(text) -> str:
    """Hostname as a filename component: no path separators, no leading dot."""
    return re.sub(r"[^A-Za-z0-9._-]", "_", str(text)).lstrip(".") or "truenas"


def release_from_filename(path):
    """TrueNAS names exports <host>-<release>-<date>.tar; the database itself holds no release."""
    m = re.search(r"(?<![\d.])(\d{2}\.\d{1,2}(?:\.\d{1,3}){0,3})(?![\d])", os.path.basename(path))
    return m.group(1) if m else None


def build_doc(ctx: Ctx, sections: list[str], appendix: bool) -> Doc:
    doc = Doc()
    host, fqdn = hostname(ctx)
    now = dt.datetime.now().astimezone()
    cfg = ctx.cfg

    doc.h1(f"Disaster Recovery Record — {fqdn}")
    if ctx.unredacted:
        doc.warn("UNREDACTED — this document contains plaintext passwords, keys and "
                 "credentials. Store it offline (fire safe, encrypted media) and destroy "
                 "superseded copies.")
    release = release_from_filename(cfg.path)
    header = [
        ("Hostname", fqdn),
        ("Generated", now.strftime("%Y-%m-%d %H:%M %Z")),
        ("Source file", os.path.basename(cfg.path)),
        ("Source SHA-256", cfg.sha256),
        ("Source size", f"{cfg.size:,} bytes"),
        ("Archive contents", ", ".join(f"{n} ({s:,} B)" for n, s in cfg.members)),
        ("Secret seed present", "yes" if cfg.secret else
         "NO — encrypted fields cannot be restored or read"),
        ("TrueNAS release", release + "  (read from the export's file name)" if release else
         "not recorded in the export — write it here by hand"),
        ("Database schema revision", str(scalar(ctx, "alembic_version", "version_num", "unknown"))),
        ("Time zone", str(scalar(ctx, "system_settings", "stg_timezone", ""))),
        ("Mode", "UNREDACTED" if ctx.unredacted else "redacted"),
        ("Detail", "full" if ctx.full else "summary"),
        ("Generator", f"truenas_config_dr.py v{VERSION}"),
    ]
    doc.kv(header)   # the decryption result is appended once the sections are built

    doc.h1("Restore runbook")
    pools = [str(x) for x in column(ctx, "storage_volume", "vol_name")]
    enc_rows = ctx.rows("storage_encrypteddataset") or []
    keyed = [r for r in enc_rows if r.get("encryption_key") not in (None, "")]
    repl = ctx.rows("storage_replication") or []
    ifaces = [str(x) for x in column(ctx, "network_interfaces", "int_interface")]
    doc.ol([
        "Install TrueNAS on the replacement boot device — the same release that produced "
        "this export, or a newer one"
        + (f" (this export came from {release})." if release else
           " (the release is not stored in the export; it is normally part of the file name)."),
        "Bring up the management interface from the console so the web UI is reachable "
        + (f"(original interfaces: {', '.join(ifaces)}). " if ifaces else ". ")
        + "Interface names can change on new hardware; re-map them after restore.",
        f"Upload the configuration: System > General Settings > Manage Configuration > "
        f"Upload File, using the export whose SHA-256 is {cfg.sha256[:16]}…. "
        "The box reboots with this configuration.",
        "Check the pool(s). Pools recorded in the config import on boot when their disks "
        "are attached; if one is missing use Storage > Import Pool"
        + (f" — expected: {', '.join(pools)}." if pools else "."),
        f"Unlock encrypted datasets. {len(keyed)} dataset(s) have an encryption key stored "
        "in this config (listed under Storage) and can be unlocked from it. "
        "Passphrase-protected datasets are NOT recoverable from this file — their "
        "passphrases must come from your separate offline record.",
        "Re-map interfaces, VLANs and LAGGs if NIC names changed, then test reachability "
        "of every share (SMB/NFS/iSCSI listed below).",
        f"Verify replication ({len(repl)} task(s)): confirm SSH connections succeed and the "
        "first run after restore is incremental, not a full resend.",
        "Verify cloud sync / backup tasks run and their encryption passwords still decrypt "
        "existing remote data.",
        "Re-deploy apps: app data lives in the ix-apps dataset on the pool, not in the "
        "config file; confirm the apps pool is selected and apps start.",
        "Run a scrub, check alerts, and confirm snapshot tasks and canary/cron jobs fire.",
    ])
    doc.h2("What this file does NOT contain")
    doc.ul([
        "Pool data, snapshots, or the ix-apps dataset (app configuration and data).",
        "Passphrases for passphrase-encrypted datasets or pools.",
        "Anything outside the TrueNAS database: files in home directories, scripts stored "
        "on pools, BIOS/IPMI settings, switch/firewall config.",
        "Credentials held elsewhere (password manager, cloud provider consoles, "
        "offline prune keys, Object Lock credentials).",
    ])
    if not cfg.secret:
        doc.warn("This export has no secret seed. On restore, every stored password "
                 "(SMTP, cloud credentials, SSH keypairs, cloud-sync encryption, CHAP) "
                 "will be unusable. Re-export with 'Export Password Secret Seed' ticked.")

    for key, title, specs in SECTIONS:
        if key not in sections:
            for s in specs:
                ctx.covered.add(s.table)
            continue
        doc.h1(title)
        any_rendered = False
        for spec in specs:
            any_rendered |= render_table_spec(ctx, doc, spec)
        if not any_rendered:
            doc.p("No tables for this section exist in this TrueNAS version.")

    if appendix:
        rest = sorted(t for t in ctx.tables
                      if t not in ctx.covered and not SKIP_TABLES_RE.match(t))
        nonempty = []
        for t in rest:
            n = ctx.conn.execute(f"SELECT count(*) FROM {qi(t)}").fetchone()[0]
            if n:
                nonempty.append((t, n))
        doc.h1("Appendix — all other configuration tables")
        doc.p(f"{len(nonempty)} further non-empty tables, rendered generically. "
              "Secrets follow the same redaction rules.")
        for t, n in nonempty:
            spec = T(t, f"{t} ({n} row{'s' if n != 1 else ''})", single=(n == 1))
            ctx.covered.discard(t)
            render_table_spec(ctx, doc, spec)

    st = ctx.stats
    header.insert(7, ("Encrypted fields", f"{st['decrypted']} decrypted, "
                      f"{st['undecryptable']} could not be read"))
    if cfg.secret and st["undecryptable"] and not st["decrypted"]:
        doc.blocks.insert(1, ("warn", "None of the encrypted fields could be decrypted with the "
                              "secret seed supplied. " + ctx._why_unreadable().capitalize() + "."))
    return doc


