def _private_temp(final_path: str):
    """New 0600 file next to final_path (O_EXCL, so no symlink or stale-permission surprises)."""
    return tempfile.mkstemp(prefix=".dr-", suffix=".part", dir=os.path.dirname(final_path) or ".")


def write_secure(path: str, data: bytes):
    fd, tmp = _private_temp(path)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def gpg_key_usable(recipient: str) -> bool:
    """True if the local keyring has a key for recipient that can encrypt."""
    try:
        r = subprocess.run(["gpg", "--batch", "--with-colons", "--list-keys", "--", recipient],
                           capture_output=True, text=True)
    except OSError:
        return False
    if r.returncode != 0:
        return False
    for line in r.stdout.splitlines():
        f = line.split(":")
        # pub/sub records: field 2 = validity (r/e/d/i are unusable), field 12 = capabilities
        if f[0] in ("pub", "sub") and len(f) > 11 and f[1] not in ("r", "e", "d", "i") and "e" in f[11]:
            return True
    return False


def write_gpg(path: str, data: bytes, recipient: str | None, symmetric: bool):
    out = path + ".gpg"
    fd, tmp = _private_temp(out)
    os.close(fd)
    cmd = ["gpg", "--yes", "--auto-key-locate", "local", "--output", tmp]  # never fetch keys over the network
    if symmetric:
        cmd += ["--symmetric", "--cipher-algo", "AES256"]
    else:
        cmd += ["--encrypt", "--recipient", recipient]
    env = dict(os.environ)
    if "GPG_TTY" not in env:  # data goes over stdin, so tell pinentry where the terminal is
        for stream in (sys.stdin, sys.stdout, sys.stderr):
            try:
                env["GPG_TTY"] = os.ttyname(stream.fileno())
                break
            except (OSError, ValueError, AttributeError):
                pass
    try:
        r = subprocess.run(cmd, input=data, capture_output=True, env=env)
        if r.returncode != 0 or os.path.getsize(tmp) == 0:
            raise RuntimeError("gpg failed, nothing was written: "
                               + (r.stderr.decode(errors="replace").strip() or f"exit {r.returncode}"))
        os.chmod(tmp, 0o600)
        os.replace(tmp, out)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return out


def emit(ctx, doc, formats, outdir, gpg_recipient=None, gpg_symmetric=False):
    host, fqdn = hostname(ctx)
    stamp = dt.datetime.now().strftime("%Y-%m-%d_%H%M%S")
    tag = "UNREDACTED" if ctx.unredacted else "redacted"
    encrypt = gpg_symmetric or gpg_recipient is not None
    if gpg_recipient is not None and not gpg_recipient.strip():
        raise RuntimeError("GPG recipient is empty — refusing to fall back to plaintext output.")
    if encrypt and not shutil.which("gpg"):
        raise RuntimeError("gpg is not installed — refusing to fall back to plaintext output.")
    os.makedirs(outdir, mode=0o700, exist_ok=True)
    base = os.path.join(outdir, f"{safe_name(host)}_DR_{stamp}_{tag}")
    # render everything first so a rendering error cannot leave half the set on disk
    rendered = [(fmt, (render_md(doc, ctx.unredacted) if fmt == "md"
                       else render_html(doc, ctx.unredacted, f"DR record — {fqdn}")).encode("utf-8"))
                for fmt in formats]
    results = []
    for fmt, data in rendered:
        path = f"{base}.{fmt}"
        if encrypt:
            path = write_gpg(path, data, gpg_recipient, gpg_symmetric)
        else:
            write_secure(path, data)
        results.append(path)
    return results


