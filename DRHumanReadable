SKIP_TABLES_RE = re.compile(r"^(sqlite_|alembic_|django_|auth_|sessions?$)")


def render_table_spec(ctx: Ctx, doc: Doc, spec: T):
    ctx.covered.add(spec.table)
    raw = ctx.rows(spec.table, spec.order)
    if raw is None:
        return False
    if spec.where:
        raw = [r for r in raw if spec.where(ctx, r)]
    doc.h2(spec.title)
    if not raw:
        doc.p("None configured.")
        return True
    labels, rows, colmap = ctx.process(spec.table, raw)
    title_col = ctx.label_col(spec.table)

    if spec.single or len(raw) == 1 and not spec.summary:
        for r in rows:
            doc.kv([(l, r[l]) for l in labels if l != "id" and _keep(r[l], ctx.full)])
        return True

    # summary table
    want = [colmap[c] for c in spec.summary if c in colmap] if spec.summary else []
    # schedule column joins summary if the table has one
    want += [l for l in labels if l.endswith("schedule") and l not in want]
    if not want:
        want = [l for l in labels if l != "id"][:7]
    extra = _extras(ctx, spec.table, rows)
    hdr = want + list(extra[0].keys()) if extra else want
    doc.table(hdr, [[r[l] for l in want] + (list(extra[i].values()) if extra else [])
                    for i, r in enumerate(rows)])

    shown = set(want) | {"id"}
    if ctx.full and any(l not in shown for l in labels):
        for r in rows:
            name = r["__raw__"].get(title_col) if title_col else None
            doc.h3(f"{spec.title} — {name or '#' + str(r['__raw__'].get('id'))}")
            doc.kv([(l, r[l]) for l in labels if l != "id" and _keep(r[l], True)])
    return True


def _keep(v, full):
    if full:
        return True
    return not (v in ("", None) or (isinstance(v, Secret) and not v.present()))


def _extras(ctx, table, rows):
    """Derived columns: certificate subject/expiry."""
    if table != "system_certificate" or not HAVE_CRYPTO:
        return None
    out = []
    for r in rows:
        pem = r["__raw__"].get("cert_certificate")
        info = {"subject": "", "expires": ""}
        if pem:
            try:
                c = x509.load_pem_x509_certificate(pem.encode())
                info["subject"] = c.subject.rfc4514_string()
                na = getattr(c, "not_valid_after_utc", None) or c.not_valid_after
                info["expires"] = na.strftime("%Y-%m-%d")
            except Exception:
                info["subject"] = "(unparseable)"
        out.append(info)
    return out


