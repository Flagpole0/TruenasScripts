            if not serr and summary and isinstance(summary, list):
                lines.append(f"\n**Encryption summary for pool `{pool_name}`:**\n")
                lines.append("| Dataset | Key Format | Key Present | Locked |")
                lines.append("| :--- | :--- | :--- | :--- |")
