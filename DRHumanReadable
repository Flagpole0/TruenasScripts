def main():
    prompt_config()
    Path(OUTPUT_DIR).mkdir(parents=True, exist_ok=True)

    ts       = datetime.datetime.now().strftime("%Y-%m-%d_%H%M")
    label    = "UNREDACTED" if not REDACT_ENABLED else "redacted"
    md_path  = Path(OUTPUT_DIR) / f"truenas_runbook_{ts}_{label}.md"
    tar_path = Path(OUTPUT_DIR) / f"truenas_backup_{ts}.tar"

    session = requests.Session()
    session.headers.update({"Authorization": f"Bearer {TRUENAS_APIKEY}"})
    session.verify = VERIFY_SSL

    # Connectivity check
    print(f"Connecting to {TRUENAS_HOST} ...")
    sys_info, err = fetch(session, TRUENAS_HOST, "/system/info")
    if err:
        print(f"  ✗ Connection failed: {err}")
        sys.exit(1)
    hostname = sys_info.get("hostname", "unknown") if isinstance(sys_info, dict) else "unknown"
    version  = sys_info.get("version", "unknown") if isinstance(sys_info, dict) else "unknown"
    print(f"  ✓ Connected — {hostname} running {version}\n")

    # ══════════════════════════════════════════════════════════════════════════
    #  Build document
    # ══════════════════════════════════════════════════════════════════════════
    doc = []
    doc.append("# TrueNAS Infrastructure Runbook\n")
