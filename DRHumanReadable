def should_redact(key):
    k = key.lower()
    if k in REDACT_FIELDS:
        return True
    for trigger in REDACT_SUBSTRINGS:
        if trigger in k:
            return True
    return False


def redact(obj):
    if not REDACT_ENABLED:
        return obj
    if isinstance(obj, dict):
        return {k: ("***REDACTED***" if should_redact(k) else redact(v))
                for k, v in obj.items()}
    if isinstance(obj, list):
        return [redact(i) for i in obj]
    return obj


def filter_keys(data, keys):
    if keys is None or not isinstance(data, list):
        return data
    return [{k: row.get(k) for k in keys if k in row} for row in data if isinstance(row, dict)]


def fetch(session, base, endpoint):
    url = urljoin(base.rstrip("/") + "/", "api/v2.0" + endpoint)
    try:
        r = session.get(url, timeout=30)
        if r.status_code == 404:
            return None, "endpoint not available (404)"
        if r.status_code == 401:
            return None, "authentication failed (401)"
        r.raise_for_status()
        try:
            return r.json(), None
        except ValueError:
            # Non-JSON body; ValueError is the portable parent of JSONDecodeError
            return r.text[:500], None
    except Exception as e:
        return None, str(e)


def post(session, base, endpoint, payload=None):
    url = urljoin(base.rstrip("/") + "/", "api/v2.0" + endpoint)
    try:
        r = session.post(url, json=payload or {}, timeout=60)
        if r.status_code == 404:
            return None, "endpoint not available (404)"
        r.raise_for_status()
        try:
            return r.json(), None
        except ValueError:
            # Non-JSON body; ValueError is the portable parent of JSONDecodeError
            return r.text[:500], None
    except Exception as e:
        return None, str(e)


def wait_job(session, base, job_id, timeout=60, interval=2):
    """Poll /core/get_jobs until a job finishes. Returns (result, error)."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        jobs, err = post(session, base, "/core/get_jobs", [[["id", "=", job_id]]])
        if err:
            return None, err
        job = jobs[0] if isinstance(jobs, list) and jobs else None
        if not isinstance(job, dict):
            return None, f"job {job_id} not found"
        state = job.get("state")
        if state == "SUCCESS":
            return job.get("result"), None
        if state in ("FAILED", "ABORTED"):
            return None, str(job.get("error") or state)
        time.sleep(interval)
    return None, f"job {job_id} timed out after {timeout}s"


