def appendix_pool_health(session, base):
    """Pool status, capacity, topology detail, and vdev health."""
    lines = ["## A1 — Pool Health & Capacity\n"]
    pools, err = fetch(session, base, "/pool")
    if err:
        lines.append(f"*Skipped — {err}*\n")
        return "\n".join(lines)
    if not pools:
        lines.append("*No pools found.*\n")
        return "\n".join(lines)

    for pool in pools:
        name = pool.get("name", "unknown")
        lines.append(f"### Pool: {name}\n")
        lines.append("| Property | Value |")
        lines.append("| :--- | :--- |")
        lines.append(f"| **Status** | {pool.get('status', '—')} |")
        lines.append(f"| **Healthy** | {'Yes' if pool.get('healthy') else 'No'} |")
        lines.append(f"| **GUID** | {pool.get('guid', '—')} |")
        lines.append(f"| **Path** | {pool.get('path', '—')} |")
        lines.append(f"| **Encrypted** | {fmt_val(pool.get('is_decrypted', '—'))} |")
        scan = pool.get("scan")
        if isinstance(scan, dict):
            scan_func = scan.get("function", "—")
            scan_state = scan.get("state", "—")
            scan_end = scan.get("end_time", scan.get("end", "—"))
            scan_errs = scan.get("errors", 0)
            lines.append(f"| **Last Scan** | {scan_func} — {scan_state} (ended {fmt_val(scan_end)}, {scan_errs} errors) |")
        else:
            lines.append(f"| **Last Scan** | {fmt_val(scan)} |")

        topo = pool.get("topology", {})
        for vdev_type in ("data", "cache", "log", "spare", "special", "dedup", "metadata"):
            vdevs = topo.get(vdev_type, [])
            if not vdevs:
                continue
            lines.append(f"\n**{vdev_type.upper()} vdevs:**\n")
            for vdev in vdevs:
                vname = vdev.get("name", vdev.get("type", "unknown"))
                vstatus = vdev.get("status", "—")
                lines.append(f"- **{vname}** — status: {vstatus}")
                children = vdev.get("children", [])
                for child in children:
                    cname = child.get("device", child.get("name", "—"))
                    cstatus = child.get("status", "—")
                    cstats = child.get("stats", {})
                    read_errs = cstats.get("read_errors", 0)
                    write_errs = cstats.get("write_errors", 0)
                    cksum_errs = cstats.get("checksum_errors", 0)
                    lines.append(f"  - `{cname}` — {cstatus} "
                                 f"(R:{read_errs} W:{write_errs} C:{cksum_errs} errors)")
        lines.append("")
    return "\n".join(lines) + "\n"


def appendix_smart(session, base):
    """Latest SMART results per disk."""
    lines = ["## A2 — Disk SMART Health\n"]
    disks, err = fetch(session, base, "/disk")
    if err:
        lines.append(f"*Skipped — {err}*\n")
        return "\n".join(lines)
    if not disks:
        lines.append("*No disks found.*\n")
        return "\n".join(lines)

    lines.append("| Disk | Model | Serial | Size | Pool | Temp |")
    lines.append("| :--- | :--- | :--- | :--- | :--- | :--- |")

    for disk in disks:
        name = disk.get("name", "—")
        temp_val = disk.get("temperature")
        temp = f"{temp_val}°C" if temp_val else "—"
        lines.append(
            f"| {name} "
            f"| {pipe_escape(fmt_val(disk.get('model','—'), 30))} "
            f"| {disk.get('serial','—')} "
            f"| {fmt_bytes(disk.get('size', 0))} "
            f"| {disk.get('pool','—') or '—'} "
            f"| {temp} |"
        )

    smart_results, serr = fetch(session, base, "/smart/test/results")
    if not serr and smart_results and isinstance(smart_results, list):
        lines.append("\n### Recent SMART Test Results\n")
        lines.append("| Disk | Test Type | Status | Remaining | Lifetime Hours | LBA of First Error |")
        lines.append("| :--- | :--- | :--- | :--- | :--- | :--- |")
        for result in smart_results:
            if not isinstance(result, dict):
                continue
            disk_name = result.get("disk", "—")
            tests = result.get("tests", [])
            for test in (tests[:5] if tests else []):
                if not isinstance(test, dict):
                    continue
                lines.append(
                    f"| {disk_name} "
                    f"| {fmt_val(test.get('type', test.get('description', '—')), 15)} "
                    f"| {fmt_val(test.get('status', '—'), 25)} "
                    f"| {fmt_val(test.get('remaining', '—'))} "
                    f"| {fmt_val(test.get('lifetime', test.get('power_on_hours', '—')))} "
                    f"| {fmt_val(test.get('lba_of_first_error', '—'))} |"
                )
    lines.append("")
    return "\n".join(lines) + "\n"


def appendix_encryption(session, base):
