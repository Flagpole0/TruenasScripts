    doc.append(f"> **Version:** {version}  ")
    doc.append(f"> **Generated:** {ts}  ")
    doc.append(f"> **Redaction:** {'Enabled — secrets masked' if REDACT_ENABLED else 'DISABLED — plain text secrets included'}  ")

    if not REDACT_ENABLED:
        doc.append("")
        doc.append("---")
        doc.append("")
        doc.append("> **⚠️  WARNING: THIS DOCUMENT CONTAINS UNREDACTED CREDENTIALS**  ")
        doc.append("> ")
        doc.append("> This file includes passwords, API keys, encryption secrets, and  ")
        doc.append("> private keys in **plain text**. It is intended for secure offline  ")
        doc.append("> storage only (encrypted drive, fire safe, safety deposit box).  ")
        doc.append("> ")
        doc.append("> **Do not share electronically. Do not store in cloud services.  ")
        doc.append("> Do not commit to version control.**  ")

    doc.append("")
    doc.append("---\n")

    # ── Master table of contents ──────────────────────────────────────────────
    doc.append("## Table of Contents\n")
    doc.append("### Part 1 — Configuration Archive\n")
    for i, (lbl, _, _, _) in enumerate(SECTIONS, 1):
        anchor = lbl.lower().replace(" ", "-").replace("/","").replace("(","").replace(")","")
        doc.append(f"{i}. [{lbl}](#{anchor})")

    if DEEP_DIVE:
        doc.append("\n### Part 2 — Deep Dive Appendix\n")
        appendix_titles = [
            "A1 — Pool Health & Capacity",
            "A2 — Disk SMART Health",
            "A3 — Encryption Status",
            "A4 — Cloud Credentials Inventory",
            "A5 — iSCSI Topology Map",
            "A6 — Update & Patch Status",
            "A7 — Application Detail",
            "A8 — Audit Log (Recent Activity)",
            "A9 — Dataset Quota Utilisation",
            "A10 — System Dataset & Syslog",
        ]
        for title in appendix_titles:
            anchor = title.lower().replace(" ", "-").replace("—","").replace("&","").replace("/","")
            anchor = anchor.replace("(","").replace(")","").replace("  ", "-")
            doc.append(f"- [{title}](#{anchor})")

    doc.append("\n---\n")

    # ══════════════════════════════════════════════════════════════════════════
    #  Part 1 — Configuration Archive
    # ══════════════════════════════════════════════════════════════════════════
    doc.append("# Part 1 — Configuration Archive\n")

    success = 0
    skipped = 0

    for lbl, endpoint, key_filter, mode in SECTIONS:
        print(f"  [{success+skipped+1:2d}/{len(SECTIONS)}] {lbl:<30s} {endpoint}")
        data, err = fetch(session, TRUENAS_HOST, endpoint)

        doc.append(f"## {lbl}\n")

        if err:
            doc.append(f"*Skipped — {err}*\n")
            skipped += 1
            continue

        data = redact(data)
        data = filter_keys(data, key_filter)
        doc.append(format_section(data, mode))
        success += 1

    print(f"\n  Part 1 complete: {success} sections, {skipped} skipped\n")

    # ══════════════════════════════════════════════════════════════════════════
    #  Part 2 — Deep Dive Appendix
    # ══════════════════════════════════════════════════════════════════════════
