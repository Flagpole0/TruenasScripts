def looks_like_tar(b):
    """POSIX tar files carry the 'ustar' magic at byte offset 257."""
    return isinstance(b, (bytes, bytearray)) and len(b) > 512 and b[257:262] == b"ustar"


def download_config(session, base):
    """
    Download the config DB backup, handling both API generations:
      - Modern SCALE: core.download returns [job_id, url]; fetch the URL
      - Legacy:       POST /config/save streams the tar directly
    Raises on failure; validates the result is actually a tar.
    """
    root = base.rstrip("/") + "/"

    # ── Modern flow: core.download ────────────────────────────────────────────
    try:
        r = session.post(urljoin(root, "api/v2.0/core/download"),
                         json=["config.save", [{"secretseed": True}], "config.tar"],
                         timeout=60)
        if r.ok:
            resp = r.json()
            if isinstance(resp, list) and len(resp) == 2:
                _job_id, dl_path = resp
                r2 = session.get(urljoin(root, str(dl_path).lstrip("/")), timeout=120)
                r2.raise_for_status()
                if looks_like_tar(r2.content):
                    return r2.content
    except Exception:
        pass  # fall through to legacy

    # ── Legacy flow: direct /config/save ──────────────────────────────────────
    r = session.post(urljoin(root, "api/v2.0/config/save"),
                     json={"secretseed": True}, timeout=120)
    r.raise_for_status()
    if looks_like_tar(r.content):
        return r.content

    raise RuntimeError(
        f"API returned {len(r.content)} bytes that are not a tar archive "
        f"(starts with {r.content[:24]!r}). This TrueNAS version may require "
        f"a different download flow — save the config manually from the UI."
    )


