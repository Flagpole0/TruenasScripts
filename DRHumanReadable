try:
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
    from cryptography import x509
    HAVE_CRYPTO = True
except (KeyboardInterrupt, SystemExit):
    raise
except BaseException:  # missing or broken install (a mismatched build raises a non-Exception
    HAVE_CRYPTO = False  # panic): decryption and certificate parsing become unavailable

VERSION = "1.1"
MAX_EXPORT_BYTES = 512 * 1024 * 1024   # a config export is a few MB at most
MAX_MEMBER_BYTES = 256 * 1024 * 1024
SQLITE_MAGIC = b"SQLite format 3\x00"


class ConfigError(Exception):
    pass


# ---------------------------------------------------------------------------
# Loading the export
# ---------------------------------------------------------------------------

class LoadedConfig:
    def __init__(self, path, conn, secret, members, sha256, size):
        self.path = path
        self.conn = conn
        self.secret = secret
        self.members = members      # [(name, size)] inside the tar
        self.sha256 = sha256
        self.size = size


def qi(name: str) -> str:
    """Quote an SQL identifier taken from the (untrusted) database itself."""
    return '"' + str(name).replace('"', '""') + '"'


def clean(text, keep_newlines=False) -> str:
    """Strip control characters from database text before it reaches a terminal or filename."""
    ok = "\n\t" if keep_newlines else ""
    return "".join(c for c in str(text) if c.isprintable() or c in ok)


def _db_to_memory(db_bytes: bytes) -> sqlite3.Connection:
    if db_bytes[18:20] == b"\x02\x02":
        # WAL-mode header: an in-memory image has no -wal file, so SQLite refuses to
        # open it. Flag the copy as rollback-journal mode (documented SQLite technique).
        db_bytes = db_bytes[:18] + b"\x01\x01" + db_bytes[20:]
    conn = sqlite3.connect(":memory:")
    if hasattr(conn, "deserialize"):
        conn.deserialize(db_bytes)
    else:  # Python < 3.11: short-lived private copy in RAM-backed storage
        tmpdir = "/dev/shm" if os.path.isdir("/dev/shm") else None
        fd, tmp = tempfile.mkstemp(prefix=".tncfg-", dir=tmpdir)
        try:
            os.fchmod(fd, 0o600)
            os.write(fd, db_bytes)
            os.close(fd)
            src = sqlite3.connect(tmp)
            src.backup(conn)
            src.close()
        finally:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    conn.execute("PRAGMA query_only = ON")
    conn.row_factory = sqlite3.Row
    return conn


def load_config(path: str, seed_path: str | None = None) -> LoadedConfig:
    if os.path.getsize(path) > MAX_EXPORT_BYTES:
        raise ConfigError(f"{os.path.basename(path)} is larger than "
                          f"{MAX_EXPORT_BYTES // 2**20} MB — not a TrueNAS config export.")
    with open(path, "rb") as fh:
        data = fh.read()
    sha = hashlib.sha256(data).hexdigest()
    db_bytes, secret, members = None, None, []

    if data[:16] == SQLITE_MAGIC:
        db_bytes = data
        members.append((os.path.basename(path), len(data)))
    else:
        try:
            tf = tarfile.open(fileobj=io.BytesIO(data), mode="r:*")
            for m in tf.getmembers():
                if not m.isfile():
                    continue
                if m.size > MAX_MEMBER_BYTES:
                    members.append((m.name, m.size))
                    continue
                blob = tf.extractfile(m).read()
                members.append((m.name, len(blob)))
                base = os.path.basename(m.name)
                if blob[:16] == SQLITE_MAGIC and db_bytes is None:
                    db_bytes = blob
                elif base == "pwenc_secret":
                    secret = blob
        except (tarfile.TarError, EOFError, OSError, ValueError) as e:
            detail = "" if isinstance(e, tarfile.ReadError) else f" ({e or type(e).__name__})"
            raise ConfigError("Not a readable TrueNAS config export — expected the .tar or .db "
                              f"file downloaded from TrueNAS{detail}.")
        if db_bytes is None:
            raise ConfigError("Archive has no SQLite database (freenas-v1.db).")

    if seed_path:
        with open(seed_path, "rb") as fh:
            secret = fh.read()

    try:
        conn = _db_to_memory(db_bytes)
        conn.execute("SELECT count(*) FROM sqlite_master").fetchone()
    except sqlite3.Error as e:
        raise ConfigError(f"Database unreadable: {e}")
    return LoadedConfig(path, conn, secret, members, sha, len(data))


# ---------------------------------------------------------------------------
# TrueNAS password encryption (middlewared pwenc): base64(nonce8 || AES-CTR)
# with '{' padding to 32-byte blocks, key = pwenc_secret.
# ---------------------------------------------------------------------------

def _printable(s: str) -> bool:
    return all(c.isprintable() or c in "\n\r\t" for c in s)


class Pwenc:
    def __init__(self, secret: bytes | None):
        self.key = secret
        self.available = bool(HAVE_CRYPTO and secret and len(secret) in (16, 24, 32))

    @staticmethod
    def looks_encrypted(value) -> bool:
        """True if value has the exact shape pwenc produces: base64 of 8 + 32*n bytes."""
        if not isinstance(value, str) or len(value) < 56:
            return False
        try:
            raw = base64.b64decode(value, validate=True)
        except Exception:
            return False
        return len(raw) >= 40 and (len(raw) - 8) % 32 == 0

    def decrypt(self, value):
        if not self.available or not isinstance(value, str) or len(value) < 16:
            return None
        try:
            raw = base64.b64decode(value, validate=True)
        except Exception:
            return None
        nonce, ct = raw[:8], raw[8:]
        if len(raw) < 9 or len(ct) % 16:
            return None
        for start in (1, 0):  # pycryptodome Counter default starts at 1
            d = Cipher(algorithms.AES(self.key),
                       modes.CTR(nonce + start.to_bytes(8, "big"))).decryptor()
            pt = (d.update(ct) + d.finalize()).rstrip(b"{")
            try:
                s = pt.decode("utf-8")
            except UnicodeDecodeError:
                continue
            if _printable(s):
                return s
        return None


# ---------------------------------------------------------------------------
# Secret classification
# ---------------------------------------------------------------------------

SECRET_RE = re.compile(
    r"(pass|pwd|_pw$|bindpw|secret|privatekey|private_key|token|psk|key$|"
    r"oauth|keytab|community|otp|seed|salt|license)", re.I)
PUBLIC_RE = re.compile(
    r"(_pub$|public|pubkey|remote_host_key|keytype|key_type|_id$|uid$|"
    r"fingerprint|^id$|enabled?$|passwordauth|password_disabled|kdf)", re.I)
HASH_RE = re.compile(r"hash", re.I)
B64_RE = re.compile(r"[A-Za-z0-9+/]{24,}={0,2}")
NESTED_SECRET_RE = re.compile(SECRET_RE.pattern + r"|url|webhook|key|account|"
                              r"client_id|tenant|hostkey", re.I)
NESTED_PUBLIC_RE = re.compile(r"(public_key|remote_host_key|^username$|^user$|^host$|"
                              r"^hostname$|^port$|endpoint|region|bucket|^type$|"
                              r"^provider$|timeout|^folder$|^cipher$)", re.I)
# Columns whose name looks secret but is not.
PUBLIC_COLS = {("system_keyvalue", "key")}


class Secret:
    """A sensitive value. Rendering depends on the output mode."""
    def __init__(self, raw, plain=None, kind="secret", note=None):
        self.raw, self.plain, self.kind, self.note = raw, plain, kind, note

    def present(self):
        return self.raw not in (None, "", b"")

    def show(self, unredacted: bool) -> str:
        if not self.present():
            return "[empty]"
        if self.kind == "hash":
            if self.raw in ("*", "!", "x"):
                return "[no password set]"
            return "[hash stored — restored with config]"
        if not unredacted:
            return "[set]"
        if self.plain is not None:
            return self.plain
        return f"{self.raw}  [{self.note or 'not decrypted'}]"


def _maybe_b64_text(s: str):
    """SSH host keys etc. are stored base64; show them as PEM if they are."""
    try:
        t = base64.b64decode(s, validate=True).decode("utf-8")
        return t if t.startswith("-----BEGIN") or t.startswith("ssh-") else None
    except Exception:
        return None


def redact_nested(obj, unredacted: bool, strict: bool = False, _force: bool = False):
    """Redact secret leaves of a JSON structure.

    strict  — the blob was stored encrypted by TrueNAS: every string is treated as
              secret unless its key is on the known-harmless list (fail closed).
    _force  — we are underneath a key that is itself secret: redact everything.
    """
    if unredacted:
        return obj
    if isinstance(obj, dict):
        out = {}
        for k, v in obj.items():
            k = str(k)
            public = bool(NESTED_PUBLIC_RE.search(k))
            secret = _force or (bool(NESTED_SECRET_RE.search(k)) and not public)
            if isinstance(v, (dict, list)):
                out[k] = redact_nested(v, unredacted, strict, secret)
            elif isinstance(v, bool) or v is None:
                out[k] = v
            elif secret or (strict and isinstance(v, str) and not public):
                out[k] = "[set]" if v != "" else "[empty]"
            else:
                out[k] = v
        return out
    if isinstance(obj, list):
        out = []
        for v in obj:
            if isinstance(v, (dict, list)):
                out.append(redact_nested(v, unredacted, strict, _force))
            elif isinstance(v, bool) or v is None:
                out.append(v)
            elif _force or (strict and isinstance(v, str)):
                out.append("[set]" if v != "" else "[empty]")
            else:
                out.append(v)
        return out
    return obj


def multiline_leaves(obj, path=""):
    """(path, text) for every multi-line string in a JSON structure, e.g. private keys."""
    if isinstance(obj, dict):
        for k, v in obj.items():
            yield from multiline_leaves(v, f"{path}.{k}" if path else str(k))
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            yield from multiline_leaves(v, f"{path}[{i}]")
    elif isinstance(obj, str) and "\n" in obj:
        yield path, obj


# ---------------------------------------------------------------------------
# Database inspection and value formatting
# ---------------------------------------------------------------------------

SCHED_PARTS = ("minute", "hour", "daymonth", "month", "dayweek")


class Ctx:
    def __init__(self, cfg: LoadedConfig, unredacted: bool, full: bool,
                 builtin_users: bool):
        self.cfg, self.conn = cfg, cfg.conn
        self.pw = Pwenc(cfg.secret)
        self.unredacted, self.full, self.builtin_users = unredacted, full, builtin_users
        self.tables = {r[0] for r in self.conn.execute(
            "SELECT name FROM sqlite_master WHERE type='table'")}
        self._cols, self._fks, self._labels = {}, {}, {}
        self.covered = set()
        self.stats = {"secrets": 0, "decrypted": 0, "undecryptable": 0}

    # --- schema helpers ---------------------------------------------------
    def cols(self, table):
        if table not in self._cols:
            self._cols[table] = [(r["name"], (r["type"] or "").upper())
                                 for r in self.conn.execute(f"PRAGMA table_info({qi(table)})")]
        return self._cols[table]

    def fks(self, table):
        if table not in self._fks:
            self._fks[table] = {r["from"]: (r["table"], r["to"]) for r in
                                self.conn.execute(f"PRAGMA foreign_key_list({qi(table)})")}
        return self._fks[table]

    def rows(self, table, order=None):
        if table not in self.tables:
            return None
        q = f"SELECT * FROM {qi(table)}"
        names = [c for c, _ in self.cols(table)]
        if order and order in names:
            q += f" ORDER BY {qi(order)}"
        elif "id" in names:
            q += " ORDER BY id"
        return [dict(r) for r in self.conn.execute(q)]

    def label_col(self, table):
        names = [c for c, _ in self.cols(table)]
        for pref in ("name", "bsdusr_username", "bsdgrp_group", "vol_name",
                     "cert_name", "int_interface", "repl_name", "description",
                     "cifs_name", "iscsi_target_name", "iscsi_target_extent_name",
                     "srv_service", "path"):
            if pref in names:
                return pref
        for c in names:
            if c.endswith("_name") or c.endswith("_description"):
                return c
        return None

    def fk_label(self, table, to_col, key):
        """Human label for a foreign key, e.g. 'alex (#2)'."""
        if key is None:
            return None
        ck = (table, to_col)
        if ck not in self._labels:
            m = {}
            try:
                if table in self.tables:
                    names = [c for c, _ in self.cols(table)]
                    to = to_col or ("id" if "id" in names else None)
                    lc = self.label_col(table)
                    if lc and to in names:
                        for r in self.conn.execute(f"SELECT {qi(to)}, {qi(lc)} FROM {qi(table)}"):
                            m[r[0]] = r[1]
            except sqlite3.Error:
                m = {}
            self._labels[ck] = m
        lbl = self._labels[ck].get(key)
        return f"{lbl} (#{key})" if lbl not in (None, "") else f"#{key}"

    @staticmethod
    def prefix(names):
        cand = [n for n in names if n != "id"]
        if len(cand) < 2:
            return ""
        p = os.path.commonprefix(cand)
        return p[:p.rfind("_") + 1] if "_" in p else ""

    # --- value processing ------------------------------------------------
    def _why_unreadable(self):
        if not self.cfg.secret:
            return "encrypted — export has no secret seed"
        if not HAVE_CRYPTO:
            return "encrypted — python3-cryptography missing or not working"
        if not self.pw.available:
            return "encrypted — secret seed has an unexpected length"
        return "encrypted — did NOT decrypt with this secret seed (seed from another system?)"

    def value(self, table, col, ctype, v):
        """Return a str or a Secret for one cell."""
        if isinstance(v, (bytes, bytearray)):
            v = v.decode("utf-8", "replace")
        if v is None:
            return ""
        if ctype == "BOOLEAN" and isinstance(v, int):
            return "yes" if v else "no"
        if not isinstance(v, str):
            return str(v)
        public = bool(PUBLIC_RE.search(col)) or (table, col) in PUBLIC_COLS
        if HASH_RE.search(col) and not public:
            return Secret(v, kind="hash")
        is_secret = bool(SECRET_RE.search(col)) and not public
        if v == "":
            return Secret(v) if is_secret else ""

        # 1. Stored encrypted by TrueNAS and we can decrypt it.
        plain = self.pw.decrypt(v)
        if plain is not None:
            self.stats["decrypted"] += 1
            if not is_secret and looks_json(plain):
                js = self._json(plain, strict=True)   # show structure, redact the leaves
                if js is not None:
                    return js
            self.stats["secrets"] += 1               # anything else that was encrypted is a secret
            return Secret(v, self._reveal(plain))

        # 2. Base64-wrapped text (SSH host keys are stored this way).
        text = _maybe_b64_text(v) if B64_RE.fullmatch(v) else None
        if text is not None:
            if is_secret:
                self.stats["secrets"] += 1
                return Secret(v, text)
            return text.rstrip("\n")

        # 3. Has the exact shape of TrueNAS ciphertext but could not be decrypted.
        if Pwenc.looks_encrypted(v):
            self.stats["undecryptable"] += 1
            why = self._why_unreadable()
            if is_secret:
                self.stats["secrets"] += 1
                return Secret(v, None, note=why)
            return f"[{why}]"

        # 4. Stored in the clear.
        if is_secret:
            self.stats["secrets"] += 1
            return Secret(v, self._reveal(v))
        if looks_json(v):
            js = self._json(v)
            if js is not None:
                return js
        return v

    def _reveal(self, plain):
        """Most usable plaintext form of a secret (only ever shown in unredacted mode)."""
        text = _maybe_b64_text(plain) if B64_RE.fullmatch(plain) else None
        if text is not None:
            return text
        if looks_json(plain):
            js = self._json(plain)
            if js:
                return js
        return plain

    def _json(self, s, strict=False):
        """Pretty JSON with secret leaves redacted; None if s is not JSON."""
        try:
            obj = json.loads(s)
        except ValueError:
            return None
        if obj in ({}, [], None):
            return ""
        text = json.dumps(redact_nested(obj, self.unredacted, strict), indent=1,
                          sort_keys=True, ensure_ascii=False)
        if self.unredacted:
            # JSON escapes newlines; repeat multi-line values (private keys) verbatim
            # so they can be copied straight out of the document.
            for path, leaf in multiline_leaves(obj):
                text += f"\n\n--- {path} (verbatim) ---\n{leaf}"
        return text

    def process(self, table, raw_rows):
        """raw rows -> (ordered labels, [{label: value}], {column: label})"""
        cols = self.cols(table)
        names = [c for c, _ in cols]
        pre = self.prefix(names)
        fks = self.fks(table)
        # schedule groups: <p>minute, <p>hour, <p>daymonth, <p>month, <p>dayweek
        sched = {}
        for c in names:
            for part in SCHED_PARTS:
                if c == part or c.endswith("_" + part):
                    sched.setdefault(c[: -len(part)], {})[part] = c
        sched = {p: d for p, d in sched.items() if len(d) == 5}
        sched_of = {c: p for p, d in sched.items() for c in d.values()}

        def label(c):
            s = c[len(pre):] if pre and c.startswith(pre) else c
            if s.endswith("_id") and c in fks:
                s = s[:-3]
            return s.replace("_", " ").strip() or c

        used = set()

        def unique(lbl, fallback):
            # two columns must never share a label, or one would silently hide the other
            if lbl in used or (lbl == "id" and fallback != "id"):
                lbl = fallback
            n, base = 2, lbl
            while lbl in used:
                lbl, n = f"{base} ({n})", n + 1
            used.add(lbl)
            return lbl

        out_cols, colmap, sched_lbl = [], {}, {}
        for c, _ in cols:
            if c in sched_of:
                p = sched_of[c]
                if p not in sched_lbl:
                    core = (p[len(pre):] if pre and p.startswith(pre) else p).strip("_").replace("_", " ")
                    lbl = core if core.endswith("schedule") else (core + " schedule").strip()
                    sched_lbl[p] = unique(lbl, p.strip("_") + "_schedule")
                    out_cols.append((sched_lbl[p], ("sched", p)))
                colmap[c] = sched_lbl[p]
                continue
            colmap[c] = unique(label(c), c)
            out_cols.append((colmap[c], ("col", c)))

        types = dict(cols)
        out = []
        for r in raw_rows:
            d = {}
            for lbl, (kind, ref) in out_cols:
                if kind == "sched":
                    parts = [r.get(sched[ref][p]) for p in SCHED_PARTS]
                    d[lbl] = ("" if all(x is None for x in parts) else
                              " ".join("*" if x is None else str(x) for x in parts)
                              + "  (m h dom mon dow)")
                elif ref in fks and r.get(ref) is not None:
                    d[lbl] = self.fk_label(fks[ref][0], fks[ref][1], r[ref])
                else:
                    d[lbl] = self.value(table, ref, types.get(ref, ""), r.get(ref))
            d["__raw__"] = r
            out.append(d)
        return [l for l, _ in out_cols], out, colmap


def looks_json(v):
    return isinstance(v, str) and len(v) >= 2 and v[0] in "{[" and v[-1] in "}]"


# ---------------------------------------------------------------------------
# Document model -> Markdown / HTML
# ---------------------------------------------------------------------------

class Doc:
    def __init__(self):
        self.blocks = []

    def h1(self, t): self.blocks.append(("h1", t))
    def h2(self, t): self.blocks.append(("h2", t))
    def h3(self, t): self.blocks.append(("h3", t))
    def p(self, t): self.blocks.append(("p", t))
    def warn(self, t): self.blocks.append(("warn", t))
    def ul(self, items): self.blocks.append(("ul", list(items)))
    def ol(self, items): self.blocks.append(("ol", list(items)))
    def code(self, t): self.blocks.append(("code", t))
    def table(self, headers, rows): self.blocks.append(("table", headers, rows))
    def kv(self, pairs): self.blocks.append(("kv", pairs))


def cell_text(v, unredacted):
    return v.show(unredacted) if isinstance(v, Secret) else ("" if v is None else str(v))


def kv_key(key, v, unredacted):
    """Flag whitespace a reader could not otherwise see on paper."""
    if unredacted and isinstance(v, Secret) and v.kind == "secret" and v.plain:
        t = v.plain
        if "\n" not in t and (t != t.strip() or "  " in t):
            return f"{key}  [{len(t)} characters, includes leading/trailing or repeated spaces]"
    return key


_MD_SPECIAL = re.compile(r"([\\`*_<\[\]|])")


def md_text(s):
    """Escape Markdown syntax in running text that came from the database."""
    return _MD_SPECIAL.sub(r"\\\1", str(s)).replace("\n", " ")


def md_code(t, in_table=True):
    """Inline code span that reproduces t exactly (backticks, spaces and all)."""
    if in_table:
        t = t.replace("\n", " ⏎ ").replace("|", "\\|")   # \| is the GFM escape inside tables
    longest = max((len(m) for m in re.findall(r"`+", t)), default=0)
    fence = "`" * (longest + 1)
    pad = " " if t.strip() and (t[0] in "` " or t[-1] in "` ") else ""
    return f"{fence}{pad}{t}{pad}{fence}"


def md_block(t):
    longest = max((len(m) for m in re.findall(r"`+", t)), default=0)
    fence = "`" * max(3, longest + 1)
    return f"{fence}\n{t}\n{fence}"


def render_md(doc: Doc, unredacted: bool) -> str:
    out = []
    for b in doc.blocks:
        k = b[0]
        if k in ("h1", "h2", "h3"):
            out.append("#" * int(k[1]) + " " + md_text(b[1]) + "\n")
        elif k == "p":
            out.append(md_text(b[1]) + "\n")
        elif k == "warn":
            out.append("> **⚠ " + md_text(b[1]) + "**\n")
        elif k == "ul":
            out.append("\n".join(f"- {md_text(i)}" for i in b[1]) + "\n")
        elif k == "ol":
            out.append("\n".join(f"{n}. {md_text(i)}" for n, i in enumerate(b[1], 1)) + "\n")
        elif k == "code":
            out.append(md_block(b[1]) + "\n")
        elif k == "table":
            hdr, rows = b[1], b[2]
            out.append("| " + " | ".join(md_text(h) for h in hdr) + " |")
            out.append("|" + "---|" * len(hdr))
            for r in rows:
                cells = [cell_text(c, unredacted) for c in r]
                out.append("| " + " | ".join(md_code(c) if c else "" for c in cells) + " |")
            out.append("")
        elif k == "kv":
            simple, multi = [], []
            for key, v in b[1]:
                t = cell_text(v, unredacted)
                key = kv_key(key, v, unredacted)
                (multi if "\n" in t or len(t) > 90 else simple).append((key, t))
            if simple:
                out.append("| Setting | Value |\n|---|---|")
                out += [f"| {md_text(a)} | {md_code(c) if c else ''} |" for a, c in simple]
                out.append("")
            for a, c in multi:
                out.append(f"**{md_text(a)}:**\n{md_block(c)}\n")
    return "\n".join(out)


