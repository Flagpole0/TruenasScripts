# Interactive wizard
# ---------------------------------------------------------------------------

def ask(prompt, default=None, choices=None):
    while True:
        suffix = f" [{default}]" if default not in (None, "") else ""
        try:
            ans = input(f"{prompt}{suffix}: ").strip()
        except EOFError:
            print()
            sys.exit("Aborted.")
        if not ans and default is not None:
            ans = str(default)
        if choices is None or ans.lower() in choices:
            return ans
        print(f"  Please answer one of: {', '.join(choices)}")


def yesno(prompt, default=False):
    a = ask(prompt + " (y/n)", "y" if default else "n", ["y", "n", "yes", "no"])
    return a.lower().startswith("y")


def find_candidates():
    dirs = [os.getcwd(), os.path.expanduser("~/Downloads")]
    found = []
    for d in dirs:
        try:
            for f in os.listdir(d):
                p = os.path.join(d, f)
                if f.lower().endswith((".tar", ".db", ".tar.gz", ".tgz")) and os.path.isfile(p):
                    found.append(p)
        except OSError:
            pass
    return sorted(set(found), key=os.path.getmtime, reverse=True)[:9]


def wizard(args):
    print(f"\nTrueNAS config → DR document  (v{VERSION})\n" + "=" * 44)
    print("Works offline from a config export. Nothing connects to your NAS.\n")

    # 1. file
    path = args.config
    if not path:
        cands = find_candidates()
        if cands:
            print("Config exports found:")
            for i, c in enumerate(cands, 1):
                ts = dt.datetime.fromtimestamp(os.path.getmtime(c)).strftime("%Y-%m-%d %H:%M")
                print(f"  {i}. {c}  ({ts})")
            a = ask("Pick a number or type a path", "1")
            path = cands[int(a) - 1] if a.isdigit() and 0 < int(a) <= len(cands) else a
        else:
            path = ask("Path to config export (.tar or .db)")
    path = path.strip()
    if len(path) > 1 and path[0] == path[-1] and path[0] in "'\"":   # dragged-in paths arrive quoted
        path = path[1:-1]
    path = os.path.expanduser(path)
    cfg = load_config(path, args.seed)
    probe = Ctx(cfg, False, False, False)
    host, fqdn = hostname(probe)
    pw_ok = probe.pw.available
    print(f"\n  Host:         {fqdn}")
    print(f"  Tables:       {len(probe.tables)}")
    print(f"  Secret seed:  {'present' if cfg.secret else 'MISSING'}")
    print(f"  Decryption:   {'available' if pw_ok else 'unavailable'}"
          + ("" if pw_ok or not cfg.secret else
             "  (install python3-cryptography)" if not HAVE_CRYPTO else
             f"  (secret seed is {len(cfg.secret)} bytes; expected 32)"))
    print(f"  SHA-256:      {cfg.sha256}\n")

    # 2. mode
    print("Output mode:\n  1. Redacted — secrets shown as [set]/[empty]  (safe to share/print)\n"
          "  2. UNREDACTED — plaintext passwords and keys  (offline vault copy only)")
    mode = ask("Choose", "1", ["1", "2"])
    unredacted = False
    if mode == "2":
        if not pw_ok:
            print("  ! Without the secret seed and python3-cryptography, encrypted fields "
                  "can't be decrypted; only plain-stored secrets will appear.")
        print(f"\n  To confirm, type the hostname exactly ({host}):")
        if ask("  Hostname") == host and yesno("  Final confirmation: write plaintext secrets?"):
            unredacted = True
        else:
            print("  Not confirmed — continuing in REDACTED mode.")

    # 3. sections
    keys = [k for k, _, _ in SECTIONS]
    print("\nSections (all included by default):")
    for i, (k, t, _) in enumerate(SECTIONS, 1):
        print(f"  {i}. {t}")
    a = ask("Numbers to EXCLUDE, comma-separated (Enter for none)", "")
    excl = {keys[int(x) - 1] for x in re.split(r"[,\s]+", a) if x.isdigit() and 0 < int(x) <= len(keys)}
    sections = [k for k in keys if k not in excl]

    # 4. detail
    full = ask("\nDetail: 1. summary tables  2. full (every setting of every object)", "2", ["1", "2"]) == "2"
    appendix = yesno("Append every other non-empty config table?", full)
    builtin = yesno("Include built-in system users and groups?", False)

    # 5. format
    f = ask("\nFormat: 1. Markdown  2. HTML (printable)  3. both", "3", ["1", "2", "3"])
    formats = {"1": ["md"], "2": ["html"], "3": ["md", "html"]}[f]

    # 6. output + encryption
    outdir = os.path.expanduser(ask("Output folder", args.out or os.getcwd()))
    rec, sym = None, False
    if shutil.which("gpg"):
        print("\nEncrypt the output with GPG? (plaintext never touches disk)\n"
              "  1. No\n  2. To a public key (recipient)\n  3. Symmetric passphrase")
        g = ask("Choose", "2" if unredacted else "1", ["1", "2", "3"])
        if g == "2":
            while True:
                rec = ask("  Recipient (email or key ID; blank to cancel)").strip()
                if not rec:
                    sys.exit("No recipient given — nothing was written.")
                if gpg_key_usable(rec):
                    break
                print(f"  No usable encryption key for {rec!r} in your keyring. "
                      "Check: gpg --list-keys")
        elif g == "3":
            sym = True
    elif unredacted:
        print("\n  ! gpg not found — unredacted output will be written as plaintext (0600).")

    ctx = Ctx(cfg, unredacted, full, builtin)
    doc = build_doc(ctx, sections, appendix)
    files = emit(ctx, doc, formats, outdir, rec, sym)
    report(ctx, files)


def report(ctx, files):
    s = ctx.stats
    print("\nDone.")
    for p in files:
        print(f"  {p}  ({os.path.getsize(p):,} bytes, mode 0600)")
    print(f"  Secret fields: {s['secrets']}   Encrypted fields decrypted: {s['decrypted']}")
    if s["undecryptable"]:
        print(f"  ! {s['undecryptable']} encrypted field(s) could not be read: "
              + ctx._why_unreadable())
    if ctx.unredacted and not any(p.endswith(".gpg") for p in files):
        print("  ⚠ Plaintext secrets on disk. Move to offline storage; note that deleting "
              "files on ZFS/SSD does not securely erase them (snapshots, TRIM).")


# ---------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(description="Build DR documentation from a TrueNAS config export (offline).")
    ap.add_argument("-c", "--config", help="config export (.tar with secret seed, or .db)")
    ap.add_argument("--seed", help="separate pwenc_secret file (if exported apart from the .db)")
    ap.add_argument("--batch", action="store_true", help="no prompts; use flags/defaults")
    ap.add_argument("--unredacted", action="store_true", help="plaintext secrets (needs --confirm-host)")
    ap.add_argument("--confirm-host", help="hostname, required with --unredacted in batch mode")
    ap.add_argument("--summary", action="store_true", help="summary tables only (default: full)")
    ap.add_argument("--no-appendix", action="store_true", help="omit generic dump of other tables")
    ap.add_argument("--builtin", action="store_true", help="include built-in users/groups")
    ap.add_argument("--sections", help="comma list: " + ",".join(k for k, _, _ in SECTIONS))
    ap.add_argument("--format", default="md,html", help="md, html or md,html")
    ap.add_argument("-o", "--out", help="output folder (default: current)")
    ap.add_argument("--gpg-recipient", help="encrypt output to this GPG key")
    ap.add_argument("--gpg-symmetric", action="store_true", help="encrypt output with a passphrase")
    ap.add_argument("--version", action="version", version=VERSION)
    args = ap.parse_args()

    try:
        if not args.batch:
            return wizard(args)
        if not args.config:
            ap.error("--batch needs --config")
        cfg = load_config(os.path.expanduser(args.config), args.seed)
        probe = Ctx(cfg, False, False, False)
        host, _ = hostname(probe)
        if args.unredacted and args.confirm_host != host:
            sys.exit(f"--unredacted requires --confirm-host {host!r}. Refusing.")
        if args.gpg_recipient is not None and args.gpg_symmetric:
            ap.error("use either --gpg-recipient or --gpg-symmetric, not both")
        if args.gpg_recipient is not None and not gpg_key_usable(args.gpg_recipient.strip() or "-"):
            sys.exit(f"No usable GPG encryption key for {args.gpg_recipient!r}. Nothing was written.")
        secs = [s.strip() for s in args.sections.split(",")] if args.sections else [k for k, _, _ in SECTIONS]
        bad = set(secs) - {k for k, _, _ in SECTIONS}
        if bad:
            ap.error(f"unknown section(s): {', '.join(sorted(bad))}")
        formats = list(dict.fromkeys(f.strip().lower() for f in args.format.split(",") if f.strip()))
        if not formats or set(formats) - {"md", "html"}:
            ap.error("--format must be md, html or md,html")
        ctx = Ctx(cfg, args.unredacted, not args.summary, args.builtin)
        doc = build_doc(ctx, secs, not args.no_appendix)
        files = emit(ctx, doc, formats, os.path.expanduser(args.out or os.getcwd()),
                     args.gpg_recipient, args.gpg_symmetric)
        report(ctx, files)
    except (ConfigError, OSError, RuntimeError, sqlite3.Error) as e:
        sys.exit(f"Error: {e}")
    except KeyboardInterrupt:
        sys.exit("\nAborted.")


if __name__ == "__main__":
    main()
