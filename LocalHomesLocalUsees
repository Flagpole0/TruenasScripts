# Passphrases
# --------------------------------------------------------------------------- #
class PassphraseGen:
    """N random words per passphrase; no word is reused within one run."""

    def __init__(self, path, n_words, sep):
        try:
            with open(path) as f:
                words = set()
                for line in f:
                    parts = line.split()
                    if not parts:
                        continue
                    w = parts[-1].lower()       # EFF format: "11111<TAB>word"
                    if re.fullmatch(r"[a-z]{3,9}", w):
                        words.add(w)
        except FileNotFoundError:
            sys.exit(f"ERROR: wordlist not found: {path}")
        if len(words) < 2048:
            sys.exit(f"ERROR: wordlist {path} has only {len(words)} usable words (need >= 2048).")
        self.pool = sorted(words)
        self.n, self.sep, self.used = n_words, sep, set()

    def bits(self):
        import math
        return self.n * math.log2(len(self.pool))

    def new(self):
        picked = []
        while len(picked) < self.n:
            w = secrets.choice(self.pool)
            if w not in self.used:
                self.used.add(w)
                picked.append(w)
        return self.sep.join(picked)


# --------------------------------------------------------------------------- #
# 4x6 cards — minimal PDF writer, standard-14 fonts, no dependencies
# --------------------------------------------------------------------------- #
CARD_W, CARD_H = 432, 288          # 6in x 4in landscape, in points
MARGIN = 24
# Average glyph widths (em fraction) for auto-fitting; Courier is exact.
WIDTH = {"F1": 0.56, "F2": 0.60, "F3": 0.60}   # Helvetica, Helvetica-Bold, Courier-Bold


def _pdf_str(s):
    s = s.encode("cp1252", "replace").decode("latin-1")
    return "(" + s.replace("\\", "\\\\").replace("(", "\\(").replace(")", "\\)") + ")"


def _fit(text, font, want, max_w):
    return min(want, max_w / max(1, len(text) * WIDTH[font]))


def _card_stream(card, title, issued, sample):
    ops = []

    def text(x, y, font, size, s, gray=0.0):
        ops.append(f"BT {gray:.2f} g /{font} {size:.1f} Tf {x:.1f} {y:.1f} Td {_pdf_str(s)} Tj ET")

    inner = CARD_W - 2 * MARGIN
    # Header band
    ops.append(f"0.12 g 0 {CARD_H - 44} {CARD_W} 44 re f")
    ops.append("BT 1 g /F2 15 Tf %.1f %.1f Td %s Tj ET" % (MARGIN, CARD_H - 28, _pdf_str(title)))
    ops.append("BT 0.75 g /F1 8.5 Tf %.1f %.1f Td %s Tj ET"
               % (CARD_W - MARGIN - 92, CARD_H - 27, _pdf_str(f"Issued {issued}")))

    # Username
    y = CARD_H - 70
    text(MARGIN, y, "F1", 8, "USERNAME", 0.40)
    size = _fit(card["username"], "F2", 22, inner)
    text(MARGIN, y - 24, "F2", size, card["username"])
    if card["full_name"] and card["full_name"] != card["username"]:
        text(MARGIN, y - 38, "F1", 9, card["full_name"], 0.35)

    # Passphrase box
    box_y, box_h = 92, 74
    ops.append(f"0.94 g {MARGIN} {box_y} {inner} {box_h} re f")
    ops.append(f"0.5 w 0.55 G {MARGIN} {box_y} {inner} {box_h} re S")
    text(MARGIN + 10, box_y + box_h - 15, "F1", 8, "PASSPHRASE", 0.40)
    pw = card["passphrase"]
    size = _fit(pw, "F3", 24, inner - 20)
    pw_w = len(pw) * 0.6 * size
    text(MARGIN + (inner - pw_w) / 2, box_y + 22, "F3", size, pw)
    text(MARGIN + 10, box_y + 8, "F1", 7,
         "All lowercase, typed exactly as shown including the separators.", 0.40)

    # Share path
    if card.get("share"):
        text(MARGIN, 72, "F1", 8, "CONNECT TO", 0.40)
        text(MARGIN + 58, 72, "F3", _fit(card["share"], "F3", 10, inner - 58), card["share"])

    # Footer
    ops.append(f"0.5 w 0.75 G {MARGIN} 50 m {CARD_W - MARGIN} 50 l S")
    text(MARGIN, 36, "F1", 7.5,
         "Keep this card private. Do not share it or store it with your device.", 0.30)
    text(MARGIN, 25, "F1", 7.5,
         "Save the passphrase in your password manager, then shred this card.", 0.30)

    if sample:
        ops.append("q 0.85 0.15 0.15 rg 1 0 0 1 0 0 cm "
                   "BT /F2 30 Tf 0.866 0.5 -0.5 0.866 120 70 Tm (SAMPLE - NOT SET) Tj ET Q")
    return "\n".join(ops).encode("latin-1")


def write_cards_pdf(path, cards, title, sample):
    issued = datetime.date.today().isoformat()
    objs = {}  # num -> bytes
    objs[1] = b"<< /Type /Catalog /Pages 2 0 R >>"
    objs[3] = b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>"
    objs[4] = b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>"
    objs[5] = b"<< /Type /Font /Subtype /Type1 /BaseFont /Courier-Bold /Encoding /WinAnsiEncoding >>"
    kids, n = [], 6
    for card in cards:
        stream = _card_stream(card, title, issued, sample)
        objs[n] = b"<< /Length %d >>\nstream\n" % len(stream) + stream + b"\nendstream"
        objs[n + 1] = (b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 %d %d] /Contents %d 0 R "
                       b"/Resources << /Font << /F1 3 0 R /F2 4 0 R /F3 5 0 R >> >> >>"
                       % (CARD_W, CARD_H, n))
        kids.append(n + 1)
        n += 2
    objs[2] = b"<< /Type /Pages /Kids [%s] /Count %d >>" % (
        " ".join(f"{k} 0 R" for k in kids).encode(), len(kids))

    out = bytearray(b"%PDF-1.4\n%\xe2\xe3\xcf\xd3\n")
    offsets = {}
    for num in sorted(objs):
        offsets[num] = len(out)
        out += b"%d 0 obj\n" % num + objs[num] + b"\nendobj\n"
    xref = len(out)
    total = max(objs) + 1
    out += b"xref\n0 %d\n0000000000 65535 f \n" % total
    for num in range(1, total):
        out += b"%010d 00000 n \n" % offsets[num]
    out += b"trailer\n<< /Size %d /Root 1 0 R >>\nstartxref\n%d\n%%%%EOF\n" % (total, xref)

    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(out)
    os.chmod(path, 0o600)


