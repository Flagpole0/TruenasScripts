class Cancelled(Exception):
    pass


def config_path(args):
    if args.config:
        return os.path.expanduser(args.config)
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "provision_local_homes.json")


def load_config(path):
    try:
        with open(path) as f:
            cfg = json.load(f)
        return {k: v for k, v in cfg.items() if k in CONFIG_KEYS} if isinstance(cfg, dict) else {}
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        print(f"  (ignoring unreadable settings file {path}: {e})")
        return {}


def save_config(path, cfg):
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({k: cfg.get(k) for k in CONFIG_KEYS if cfg.get(k) not in (None, "")},
                  f, indent=2)
        f.write("\n")
    os.chmod(path, 0o600)


def _input(prompt):
    try:
        return input(prompt)
    except EOFError:
        raise Cancelled from None


def ask(prompt, default=None, validate=None, allow_blank=False):
    """Prompt until a valid answer. Enter accepts the [default]; 'none' clears it."""
    while True:
        shown = f" [{default}]" if default not in (None, "") else ""
        raw = _input(f"  {prompt}{shown}: ").strip()
        if allow_blank and raw.lower() == "none":
            return ""
        val = raw or (default or "")
        if not val:
            if allow_blank:
                return ""
            print("    (an answer is needed here)")
            continue
        err = validate(val) if validate else None
        if err:
            print(f"    {err}")
            continue
        return val


def ask_yes(prompt, default=False):
    """default=None means there is no default: Enter alone is asked again."""
    hint = "y/n" if default is None else ("Y/n" if default else "y/N")
    while True:
        raw = _input(f"  {prompt} [{hint}]: ").strip().lower()
        if not raw and default is not None:
            return default
        if raw in ("y", "yes"):
            return True
        if raw in ("n", "no"):
            return False
        print("    please answer y or n")


def step(n, title):
    print(f"\n== Step {n} of {WIZARD_STEPS}: {title} " + "=" * max(0, 50 - len(title)))


def fmt_size(n):
    if n is None:
        return "-"
    for unit, size in (("PiB", 1024**5), ("TiB", 1024**4), ("GiB", 1024**3),
                       ("MiB", 1024**2), ("KiB", 1024)):
        if n >= size:
            v = n / size
            return f"{v:.0f} {unit}" if v == int(v) else f"{v:.1f} {unit}"
    return f"{n} B"


def dataset_acltype(ds):
    raw = ds.get("acltype")
    if isinstance(raw, dict):              # {"value": "NFSV4", ...} on most releases
        raw = raw.get("value")
    return str(raw).upper()


def equivalent_command(a, apply):
    import shlex
    here = os.path.dirname(os.path.abspath(__file__))
    prog = "./provision_local_homes.py" if os.path.abspath(os.getcwd()) == here \
        else os.path.abspath(__file__)
    parts = [prog, a.csv, "--host", a.host, "--parent", a.parent]
    if a.fingerprint:
        parts += ["--fingerprint", _fmt_fp(_norm_fp(a.fingerprint))]
    if a.ca_cert:
        parts += ["--ca-cert", a.ca_cert]
    if a.api_key_file:
        parts += ["--api-key-file", a.api_key_file]
    if a.homes_group != "nas-homes":
        parts += ["--homes-group", a.homes_group]
    if a.admin_group:
        parts += ["--admin-group", a.admin_group]
    for flag, on in (("--manage-parent", a.manage_parent), ("--create-users", a.create_users),
                     ("--reset-passwords", a.reset_passwords)):
        if on:
            parts.append(flag)
    if a.only:
        parts += ["--only", a.only]
    if needs_passphrases(a):
        if a.words != 3:
            parts += ["--words", str(a.words)]
        if a.share_path:
            parts += ["--share-path", a.share_path]
        if os.path.abspath(a.wordlist) != os.path.join(here, "eff_large_wordlist.txt"):
            parts += ["--wordlist", a.wordlist]
    if apply:
        parts.append("--apply")
    return " ".join(shlex.quote(p) for p in parts)


def wizard_connect(a, cli_fp, cfg):
    """Connect, settle certificate trust with the user, return (api, host, pinned_fp)."""
    while True:
        a.host = ask("NAS hostname or IP (add :port if not 443)", a.host)
        host, port = split_host(a.host)
        # A saved fingerprint only vouches for the host it was saved with.
        saved_fp = cli_fp or (cfg.get("fingerprint") if a.host == cfg.get("host") else None)
        try:
            api = TrueNAS(host, port, tls_context(a.ca_cert, False), None,
                          a.protocol, a.timeout)
            print("    [ok] the NAS certificate is trusted by this computer.")
            return api, host, None
        except ssl.SSLCertVerificationError:
            pass                                    # self-signed: fall through to pinning
        except (OSError, ApiError) as e:
            print(f"    cannot connect to {host}:{port}: {e}")
            print("    Check the name/IP, that the NAS is on, and that its web UI loads "
                  "over https from this computer.")
            continue
        try:
            api = TrueNAS(host, port, tls_context(None, True), None, a.protocol, a.timeout)
        except (OSError, ApiError) as e:
            print(f"    cannot connect to {host}:{port}: {e}")
            continue
        fp = api.ws.peer_fingerprint()
        print("    The NAS uses a self-signed certificate (the TrueNAS default), so this")
        print("    computer can't vouch for it. Its SHA-256 fingerprint is:\n")
        print(f"      {_fmt_fp(fp)}\n")
        if saved_fp and _norm_fp(saved_fp) == fp:
            print("    [ok] matches the fingerprint you saved last time.")
            return api, host, fp
        if saved_fp:
            print("    !! WARNING: this is NOT the fingerprint you saved last time:")
            print(f"      {_fmt_fp(_norm_fp(saved_fp))}")
            print("    That is expected only if the NAS certificate was replaced or renewed.")
            print("    Otherwise something may be intercepting the connection.")
            question = "Trust the NEW certificate anyway?"
        else:
            print("    Before trusting it, check it on the NAS itself. In the TrueNAS web UI open")
            print("    System > Shell (or SSH in) and run:\n")
            print("      midclt call system.general.config | python3 -c 'import json,sys; "
                  "print(json.load(sys.stdin)[\"ui_certificate\"][\"certificate\"])' \\")
            print("        | openssl x509 -noout -fingerprint -sha256\n")
            question = "Does the fingerprint the NAS shows match the one above?"
        if ask_yes(question, False):
            return api, host, fp
        api.close()
        raise Cancelled("certificate not trusted; nothing was sent to the NAS")


def wizard_login(api, a, host):
    """Try $TRUENAS_API_KEY / saved key file, else ask. Loops until login works."""
    tried_env = tried_file = False
    while True:
        key, source = None, None
        env_key = os.environ.get("TRUENAS_API_KEY", "").strip()
        if env_key and not tried_env:
            tried_env, key, source = True, env_key, "$TRUENAS_API_KEY"
        elif a.api_key_file and not tried_file:
            tried_file = True
            try:
                with open(os.path.expanduser(a.api_key_file)) as f:
                    key, source = f.read().strip(), a.api_key_file
            except OSError as e:
                print(f"    cannot read {a.api_key_file}: {e}")
                a.api_key_file = None
        if key is None:
            print("  Create a key in the TrueNAS web UI: user icon (top right) > API Keys > Add.")
            print("  Pick an admin user. The key is shown only once, so copy it right away.")
            path = ask("Path to a file holding the key (Enter to paste it instead)",
                       allow_blank=True)
            if path:
                try:
                    with open(os.path.expanduser(path)) as f:
                        key, source = f.read().strip(), path
                    a.api_key_file = path
                except OSError as e:
                    print(f"    cannot read {path}: {e}")
                    continue
            else:
                key = getpass.getpass("  API key (typing is hidden): ").strip()
                source = "the key you typed"
        if not key:
            print("    (no key given)")
            continue
        try:
            start_session(api, key, a.api_user, host)
            print(f"    [ok] logged in with {source} - {api.label}")
            return
        except ApiError as e:
            print(f"    login with {source} failed: {e}")


def wizard_pick_dataset(a):
    datasets = call("pool.dataset.query", [], label="list datasets") or []
    usable, hidden = [], 0
    for ds in datasets:
        mp, dsid = ds.get("mountpoint") or "", ds.get("id", "")
        if not mp.startswith("/mnt/") or any(p.startswith(".") or p == "ix-applications"
                                              for p in dsid.split("/")):
            continue
        if "NFS" in dataset_acltype(ds):
            usable.append(ds)
        else:
            hidden += 1
    usable.sort(key=lambda d: d["mountpoint"])
    print("  The folders are created inside one dataset, which must use NFSv4 ACLs.")
    if not usable:
        raise Cancelled("no NFSv4 dataset found. In TrueNAS create one under Datasets > "
                        "Add Dataset with the SMB preset (or ACL Type: NFSv4), then rerun")
    for i, ds in enumerate(usable, 1):
        print(f"    {i}) {ds['mountpoint']}")
    if hidden:
        print(f"    ({hidden} other dataset(s) hidden because they don't use NFSv4 ACLs)")
    paths = [d["mountpoint"] for d in usable]
    default = str(paths.index(a.parent) + 1) if a.parent in paths else ("1" if len(paths) == 1 else None)

    def valid(v):
        if v.isdigit():
            return None if 1 <= int(v) <= len(paths) else f"pick 1-{len(paths)}"
        return None if v.rstrip("/") in paths else "pick a number from the list"
    choice = ask("Dataset number", default, valid)
    a.parent = paths[int(choice) - 1] if choice.isdigit() else choice.rstrip("/")


def wizard_load_csv(a):
    while True:
        a.csv = ask("Path to your users CSV", a.csv or "users.csv")
        path = os.path.expanduser(a.csv)
        if not os.path.exists(path):
            print(f"    {path} doesn't exist. It's a spreadsheet saved as CSV, like:\n")
            for line in EXAMPLE_CSV.splitlines():
                print(f"      {line}")
            print("\n    groups are separated by ';'; quota is optional (500G, 1T).")
            if ask_yes(f"Create a starter {a.csv} you can edit?", True):
                fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                with os.fdopen(fd, "w") as f:
                    f.write(EXAMPLE_CSV)
                print(f"    Created {os.path.abspath(path)}. Edit it (any text editor or "
                      "spreadsheet app), save, then press Enter.")
                _input("  [Enter when done] ")
            continue
        try:
            return load_csv(path)
        except SystemExit as e:
            print(f"    {e}")
            print("    Fix the file, then press Enter to try again.")
            _input("  [Enter when done] ")


def wizard_preview(rows, parent):
    existing = {u["username"]: u for u in call("user.query", [], label="list users") or []}
    entries = list_entries(parent)
    print(f"\n  {'USERNAME':<14}{'FULL NAME':<20}{'GROUPS':<20}{'QUOTA':<9}{'ON NAS':<9}FOLDER")
    new = present = 0
    for r in rows:
        u = existing.get(r["username"])
        if u is None:
            status, new = "new", new + 1
        elif u.get("builtin") or u.get("local") is False:
            status = "skip*"
        else:
            status, present = "exists", present + 1
        kind = entries.get(r["username"])
        folder = "exists" if kind == "DIRECTORY" else ("missing" if kind is None else kind.lower())
        print(f"  {r['username'][:13]:<14}{r['full_name'][:19]:<20}"
              f"{', '.join(r['groups'])[:19] or '-':<20}{fmt_size(r['quota']):<9}"
              f"{status:<9}{folder}")
    if any(existing.get(r["username"]) and (existing[r["username"]].get("builtin")
           or existing[r["username"]].get("local") is False) for r in rows):
        print("  * system or directory-service accounts are never changed")
    print(f"\n  {len(rows)} user(s) in the CSV: {new} new, {present} already on the NAS.")
    return new, present


def wizard_options(a, cfg, new, present):
    if new:
        a.create_users = ask_yes(f"Create the {new} new user(s) with random passphrases?",
                                 cfg.get("create_users", True))
        if not a.create_users:
            print("    OK - they'll be listed as MISSING and get no folder.")
    else:
        a.create_users = False
    if present:
        a.reset_passwords = ask_yes(
            "Give users who already exist a NEW passphrase too? (they'll need the new card)",
            False)
        if a.reset_passwords:
            a.only = ask("Only one user? Type the username, or Enter for everyone in the CSV",
                         allow_blank=True) or None

    def group_ok(v):
        return None if GROUPNAME_RE.fullmatch(v) else "letters, digits, '.', '_' or '-' only"
    print("\n  Every user joins one shared group, used to let them reach their own folder.")
    a.homes_group = ask("Shared group name", cfg.get("homes_group") or "nas-homes", group_ok)
    print("\n  Optionally, an admin group can open every user's folder (for support and")
    print("  recovery). Leave blank for no admin access; type 'none' to clear a saved one.")
    a.admin_group = ask("Admin group name", cfg.get("admin_group"),
                        lambda v: group_ok(v), allow_blank=True) or None
    print("\n  Recommended: lock down the top folder so users can open their own folder")
    print("  but can't see the list of other users' folders.")
    a.manage_parent = ask_yes("Set that permission on the top folder?",
                              cfg.get("manage_parent", True))

    if needs_passphrases(a):
        def words_ok(v):
            return None if v.isdigit() and 2 <= int(v) <= 8 else "a number from 2 to 8"
        print("\n  Passphrases look like 'bedal-bakar-bacun'. 3 words is fine for a home or")
        print("  small office NAS; 4 is stronger and still easy to type.")
        a.words = int(ask("Words per passphrase", str(cfg.get("words") or 3), words_ok))
        print("\n  The cards can show how to connect, e.g. \\\\nas\\homes\\{user}")
        print("  ({user} is replaced with each username).")
        a.share_path = ask("Connection path for the cards (Enter to leave off)",
                           cfg.get("share_path"), allow_blank=True) or None
        while not os.path.exists(a.wordlist):
            print(f"\n  The passphrase wordlist isn't at {a.wordlist}. Download it with:")
            print("    wget https://www.eff.org/files/2016/07/18/eff_large_wordlist.txt")
            a.wordlist = os.path.expanduser(ask("Path to eff_large_wordlist.txt", a.wordlist))


def wizard(args):
    global _API, SHOW_DRY_DETAIL
    SHOW_DRY_DETAIL = False
    a = argparse.Namespace(**vars(args))
    cfg_file = config_path(args)
    cfg = load_config(cfg_file)
    # Command-line values win over saved ones; saved ones fill the gaps.
    for k in ("host", "api_key_file", "parent", "csv", "share_path"):
        if not getattr(a, k, None) and cfg.get(k):
            setattr(a, k, cfg[k])
    if cfg.get("wordlist") and a.wordlist.endswith("eff_large_wordlist.txt") \
            and not os.path.exists(a.wordlist):
        a.wordlist = cfg["wordlist"]
    if a.reset_passwords is None:
        a.reset_passwords = False

    print("\nTrueNAS private home folders - guided setup")
    print("Nothing is changed on the NAS until you confirm at the end.")
    print("Press Enter to accept the [default] shown. Ctrl+C cancels at any time.")
    if cfg:
        print(f"(Defaults come from your saved settings in {cfg_file})")

    applied = False
    try:
        step(1, "Connect to the NAS")
        _API, host, pinned_fp = wizard_connect(a, args.fingerprint, cfg)
        a.fingerprint = _fmt_fp(pinned_fp) if pinned_fp else None
        if pinned_fp:
            _API.fingerprint = pinned_fp       # reconnects must present the same certificate
        try:
            step(2, "API key")
            wizard_login(_API, a, host)

            step(3, "Choose the dataset")
            wizard_pick_dataset(a)

            step(4, "Users")
            rows = wizard_load_csv(a)
            csv_names = {r["username"] for r in rows}
            _API.ensure_alive()
            new, present = wizard_preview(rows, a.parent)

            step(5, "Options")
            wizard_options(a, cfg, new, present)
            if a.only:
                rows = [r for r in rows if r["username"] == a.only]
                if not rows:
                    raise Cancelled(f"'{a.only}' is not in the CSV")
            gen = PassphraseGen(a.wordlist, a.words, a.sep) if needs_passphrases(a) else None

            step(6, "Review (dry run - nothing is changed)")
            print("  This is what would happen. Lines starting with -> are changes; nothing")
            print("  else is touched. (Run the command shown at the end without --apply")
            print("  to see the exact API calls.)\n")
            _API.ensure_alive()
            ok, stats, _ = execute(a, True, a.parent, rows, csv_names, gen,
                                   None, sample_cards=False)
            if not ok:
                raise Cancelled("the dry run hit an error (shown above); nothing was changed")
            changes = sum(stats[k] for k in CHANGE_KEYS)

            step(7, "Apply")
            if not changes:
                print("  Everything is already in place - nothing to apply.")
                if stats["users_missing"]:
                    print(f"  ({stats['users_missing']} user(s) are missing because you chose "
                          "not to create them.)")
            elif ask_yes("Apply the changes listed above to the NAS now? "
                         "(type y to apply, n to stop)", None):
                applied = True
                cards_out = a.cards_out or default_cards_out(False)
                _API.ensure_alive()
                ok, stats, _ = execute(a, False, a.parent, rows, csv_names, gen, cards_out)
                print()
                if ok:
                    made = []
                    for k, label in (("users_created", "user(s) created"),
                                     ("passwords_reset", "passphrase(s) reset"),
                                     ("folders_created", "folder(s) created"),
                                     ("acls_set", "permission(s) set"),
                                     ("quotas_set", "quota(s) set")):
                        if stats[k]:
                            made.append(f"{stats[k]} {label}")
                    print("  DONE: " + (", ".join(made) or "changes applied") + ".")
                    if os.path.exists(cards_out):
                        print(f"  Credential cards: {os.path.abspath(cards_out)}")
                else:
                    print("  Stopped part-way. Fix the problem above and run again; "
                          "anything already done is kept and skipped next time.")
                    if os.path.exists(cards_out):
                        print(f"  Cards for passphrases already set: {os.path.abspath(cards_out)}")
            else:
                print("  NOT APPLIED - nothing was changed: no users, folders or cards "
                      "were created.")
        finally:
            _API.close()

        step(8, "Save settings")
        if ask_yes(f"Save these answers as defaults for next time? "
                   f"(the API key itself is never saved)", True):
            save_config(cfg_file, {
                "host": a.host, "fingerprint": a.fingerprint, "api_key_file": a.api_key_file,
                "parent": a.parent, "csv": a.csv, "homes_group": a.homes_group,
                "admin_group": a.admin_group, "manage_parent": a.manage_parent,
                "create_users": a.create_users, "share_path": a.share_path,
                "words": a.words, "wordlist": os.path.abspath(a.wordlist)})
            print(f"    Saved to {cfg_file}")
        print("\n  Next time, run with --wizard again and press Enter through the saved")
        print("  answers, or skip the questions with:\n")
        print(f"    {equivalent_command(a, apply=True)}\n")
        if not (a.api_key_file or os.environ.get("TRUENAS_API_KEY")):
            print("  (that command will ask for the API key; set TRUENAS_API_KEY or use "
                  "--api-key-file to avoid typing it)")
        return 0 if ok or not applied else 1
    except (Cancelled, KeyboardInterrupt) as e:
        reason = f": {e}" if isinstance(e, Cancelled) and str(e) else ""
        print(f"\n\nCancelled{reason}.")
        if applied:
            print("Changes made before cancelling were kept; run again to finish.")
        else:
            print("Nothing was changed on the NAS.")
        return 1


def run(args, dry, parent, rows, csv_names, gen, cards, gcache, stats):

    # --- pre-flight: parent must be an NFSv4 dataset mountpoint -------------
    ds = call("pool.dataset.query", [["mountpoint", "=", parent]], label="query parent")
    if not ds:
        raise ApiError(f"{parent} is not the mountpoint of a dataset on this NAS")
    ds = ds[0]
    acltype = dataset_acltype(ds)
    if "NFS" not in acltype:
        raise ApiError(f"dataset {ds['id']} acltype is {acltype}; set it to NFSv4 first")
    entries = list_entries(parent)

    # --- groups --------------------------------------------------------------
    print("[groups]")
    homes = ensure_group(args.homes_group, dry, gcache, stats)
    admin = ensure_group(args.admin_group, dry, gcache, stats) if args.admin_group else None
    for r in rows:
        for g in r["groups"]:
            ensure_group(g, dry, gcache, stats)
    print()

    homes_gid = homes.get("gid")
    admin_gid = admin.get("gid") if admin else None
    if admin is not None and admin_gid is None:
        admin_gid = f"<new:{args.admin_group}>"  # dry-run placeholder

    # --- parent ACL ----------------------------------------------------------
    if args.manage_parent:
        print(f"[parent {parent}]")
        want = parent_dacl(homes_gid if homes_gid is not None else f"<new:{args.homes_group}>",
                           admin_gid)
        cur = call("filesystem.getacl", parent, True, label="getacl parent")
        diffs = acl_drift(cur, 0, 0, want)
        if diffs:
            print(f"    -> SET ACL ({'; '.join(diffs)})")
            apply_acl(parent, 0, 0, want, dry, "setacl parent")
            stats["acls_set"] += 1
        else:
            print("    -> OK")
        print()

    # --- existing quotas (one query) ----------------------------------------
    quotas = {}
    if any(r["quota"] for r in rows):
        for q in call("pool.dataset.get_quota", ds["id"], "USER", label="get quotas") or []:
            quotas[q.get("id")] = q.get("quota")

    # --- per-user ------------------------------------------------------------
    for r in rows:
        name = r["username"]
        path = f"{parent}/{name}"
        print(f"[{name}]")

        member_of = [homes] + [gcache[g] for g in r["groups"]]
        uid, gid = ensure_user(r, member_of, args, dry, cards, gen, stats)
        if uid is None:
            print()
            continue

        kind = entries.get(name)
        if kind not in (None, "DIRECTORY"):
            print(f"    -> SKIP: {path} exists but is a {kind.lower()}, not a directory")
            stats["skipped"] += 1
            print()
            continue

        exists = kind == "DIRECTORY"
        if not exists:
            print(f"    -> CREATE folder {path}")
            stats["folders_created"] += 1
            if dry:
                dry_detail(f"      [DRY-RUN] filesystem.mkdir {path}")
            else:
                make_dir(path)

        want = folder_dacl(admin_gid)
        cur = call("filesystem.getacl", path, True, label=f"getacl {name}") \
            if (exists or not dry) else None
        diffs = acl_drift(cur, uid, gid, want)
        changed = False
        if diffs:
            print(f"    -> SET ACL owner {uid}:{gid} ({'; '.join(diffs)})")
            apply_acl(path, uid, gid, want, dry, f"setacl {name}")
            stats["acls_set"] += 1
            changed = True

        if r["quota"] is not None:
            have = quotas.get(uid)
            if have != r["quota"]:
                print(f"    -> SET quota {have} -> {r['quota']} bytes")
                call("pool.dataset.set_quota", ds["id"],
                     [{"quota_type": "USER", "id": str(uid), "quota_value": r["quota"]}],
                     dry=dry, mutate=True, label=f"quota {name}")
                stats["quotas_set"] += 1
                changed = True

        if not changed and exists:
            print("    -> folder OK")
            stats["ok"] += 1
        print()

    # --- orphans (report only) ----------------------------------------------
    orphans = sorted(n for n, t in entries.items()
                     if t == "DIRECTORY" and not n.startswith(".") and n not in csv_names)
    if orphans:
        print("[orphans] folders with no CSV row (NOT touched):")
        for o in orphans:
            print(f"    {parent}/{o}")
        print()
    return orphans


