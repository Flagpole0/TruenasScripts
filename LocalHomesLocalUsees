def build_parser():
    # allow_abbrev=False: otherwise "--api-key SECRET" would silently expand to
    # --api-key-file and echo the secret back in the "cannot read" error.
    ap = argparse.ArgumentParser(
        allow_abbrev=False,
        description="Provision private per-user folders on TrueNAS SCALE from a CSV, over the API.")
    ap.add_argument("csv", nargs="?", help="CSV of users (username,full_name,groups,quota)")
    ap.add_argument("--parent", help="Mountpoint of the parent dataset, e.g. /mnt/tank/homes")

    con = ap.add_argument_group("connection")
    con.add_argument("--host", default=os.environ.get("TRUENAS_HOST"),
                     help="TrueNAS host or host:port (default: $TRUENAS_HOST)")
    con.add_argument("--fingerprint", default=os.environ.get("TRUENAS_FINGERPRINT"),
                     help="Pin the NAS TLS certificate by SHA-256 fingerprint "
                          "(default: $TRUENAS_FINGERPRINT)")
    con.add_argument("--ca-cert", help="CA bundle to verify the NAS certificate against "
                                       "(instead of the system trust store)")
    con.add_argument("--show-fingerprint", action="store_true",
                     help="Print the NAS certificate fingerprint and exit (no login)")
    con.add_argument("--api-key-file", help="File holding the API key (else $TRUENAS_API_KEY, else prompt)")
    con.add_argument("--api-user", help="Username the key belongs to; only needed if the "
                                        "server rejects the older key-login call")
    con.add_argument("--protocol", choices=("auto", "jsonrpc", "legacy"), default="auto",
                     help="API endpoint: /api/current (jsonrpc), /websocket (legacy), or auto")
    con.add_argument("--timeout", type=float, default=60,
                     help="Seconds to wait for the NAS to answer (default 60)")

    ap.add_argument("--homes-group", default="nas-homes",
                    help="Group every CSV user joins; gets TRAVERSE on the parent (default: nas-homes)")
    ap.add_argument("--admin-group", help="Optional break-glass group with FULL_CONTROL on every folder")
    ap.add_argument("--manage-parent", action="store_true",
                    help="Also converge the parent dataset root's ACL (traverse-only for members)")
    ap.add_argument("--create-users", action="store_true",
                    help="Create missing local users with a random passphrase")
    ap.add_argument("--reset-passwords", action="store_true",
                    help="Also give EXISTING users (in scope) a new passphrase. Combine with --only.")
    ap.add_argument("--words", type=int, default=3, help="Words per passphrase (default 3)")
    ap.add_argument("--sep", default="-", help="Word separator (default '-')")
    ap.add_argument("--wordlist",
                    default=os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                         "eff_large_wordlist.txt"),
                    help="Wordlist file (default: eff_large_wordlist.txt next to this script)")
    ap.add_argument("--cards-out",
                    help="PDF of 4x6 credential cards (mode 0600). "
                         "Default: homes-cards-<timestamp>.pdf (or -SAMPLE in dry-run)")
    ap.add_argument("--card-title", default="Network Storage Access",
                    help="Heading printed on each card")
    ap.add_argument("--share-path",
                    help=r"Optional connect-to line; {user} is replaced, e.g. '\\nas\homes\{user}'")
    ap.add_argument("--only", metavar="USER", help="Process only this username")
    ap.add_argument("--apply", action="store_true", help="Execute changes (default is dry-run)")
    ap.add_argument("--wizard", action="store_true",
                    help="Step-by-step guided mode (also starts when run with no arguments)")
    ap.add_argument("--config", help="Settings file the wizard reads and saves "
                                     "(default: ~/.config/provision_local_homes.json)")
    return ap


def connect(args):
    host, port = split_host(args.host)
    if not host:
        sys.exit("ERROR: --host is required (or set TRUENAS_HOST, or run with --wizard).")
    pinned = bool(args.fingerprint) or args.show_fingerprint
    if args.fingerprint and len(_norm_fp(args.fingerprint)) != 64:
        sys.exit("ERROR: --fingerprint must be a SHA-256 fingerprint (64 hex digits).")
    ctx = tls_context(args.ca_cert, pinned)
    try:
        api = TrueNAS(host, port, ctx, None if args.show_fingerprint else args.fingerprint,
                      args.protocol, args.timeout)
    except ssl.SSLCertVerificationError as e:
        sys.exit(f"ERROR: TLS verification failed for {host}: {e.verify_message}.\n"
                 "  TrueNAS uses a self-signed certificate by default. Run with "
                 "--show-fingerprint, check it against the NAS, then pass --fingerprint.")
    except (OSError, ApiError) as e:
        sys.exit(f"ERROR: cannot connect to {host}:{port}: {e}")
    return api, host, port


def start_session(api, api_key, api_user, host):
    """Log in and label the connection for the run header. Raises ApiError."""
    api.login(api_key, api_user)
    try:
        version = api.call("system.version")
    except ApiError:
        version = "unknown version"
    api.label = f"{host} ({version}, {api.protocol} API)"


CHANGE_KEYS = ("groups_created", "users_created", "memberships_added", "passwords_reset",
               "folders_created", "acls_set", "quotas_set")


def execute(args, dry, parent, rows, csv_names, gen, cards_out, sample_cards=True):
    """One provisioning pass on the open connection. Returns (ok, stats, orphans)."""
    print(f"=== local homes provisioner [{'DRY-RUN' if dry else 'APPLY'}] "
          f"{_API.label} parent={parent} ===\n")
    stats = {k: 0 for k in ("groups_created", "users_created", "users_missing",
                            "memberships_added", "passwords_reset", "skipped",
                            "folders_created", "acls_set", "quotas_set", "ok")}
    cards, gcache, orphans, failed = [], {}, [], None
    if gen is not None:
        print(f"passphrases: {gen.n} words from {len(gen.pool)} "
              f"(~{gen.bits():.0f} bits each), separator '{gen.sep}'\n")
    try:
        orphans = run(args, dry, parent, rows, csv_names, gen, cards, gcache, stats)
    except ApiError as e:
        failed = e
    finally:
        # Always emit cards for passphrases already set, even if a later step failed.
        if cards and (sample_cards or not dry):
            write_cards_pdf(cards_out, cards, args.card_title, sample=dry)
            label = "SAMPLE card(s) — passphrases NOT set" if dry else "credential card(s)"
            print(f"!! {len(cards)} {label} written to {os.path.abspath(cards_out)} (0600).")
            if not dry:
                print("   Store in a password manager, hand out, then shred the PDF "
                      "and any printouts.\n")
            else:
                print()

    if failed:
        print(f"ERROR: {failed}\n(stopped; changes made before this point were kept)",
              file=sys.stderr)
        return False, stats, orphans

    print("=== summary ===")
    for k, v in stats.items():
        print(f"  {k.replace('_', ' '):<18} {v}")
    print(f"  {'orphans':<18} {len(orphans)}")
    return True, stats, orphans


def needs_passphrases(args):
    return args.create_users or args.reset_passwords


def default_cards_out(dry):
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    return f"homes-cards-{stamp}{'-SAMPLE' if dry else ''}.pdf"


def main(argv=None):
    global _API
    argv = sys.argv[1:] if argv is None else list(argv)
    args = build_parser().parse_args(argv)

    if args.wizard or (not argv and sys.stdin.isatty() and sys.stdout.isatty()):
        sys.exit(wizard(args))

    if args.show_fingerprint:
        api, host, port = connect(args)
        fp = api.ws.peer_fingerprint()
        api.close()
        print(f"{host}:{port}  ({api.protocol} API)\nSHA-256 fingerprint: {_fmt_fp(fp)}")
        print("Check it against the NAS before trusting it (see README), then pass "
              "--fingerprint or set TRUENAS_FINGERPRINT.")
        return

    if not args.csv or not args.parent:
        sys.exit("ERROR: the CSV argument and --parent are required "
                 "(or run with --wizard to be asked step by step).")
    dry = not args.apply
    parent = os.path.normpath(args.parent).replace("\\", "/")
    if not parent.startswith("/mnt/"):
        sys.exit(f"ERROR: --parent must be a path on the NAS under /mnt/, got {parent}")
    if args.words < 2:
        sys.exit("ERROR: --words must be at least 2.")
    gen = PassphraseGen(args.wordlist, args.words, args.sep) if needs_passphrases(args) else None
    cards_out = args.cards_out or default_cards_out(dry)

    rows = load_csv(args.csv)
    csv_names = {r["username"] for r in rows}
    if args.only:
        rows = [r for r in rows if r["username"] == args.only]
        if not rows:
            sys.exit(f"ERROR: --only '{args.only}' matched no CSV row.")

    api_key = read_api_key(args)
    _API, host, port = connect(args)
    try:
        start_session(_API, api_key, args.api_user, host)
    except ApiError as e:
        _API.close()
        sys.exit(f"ERROR: {e}")
    del api_key
    try:
        ok, _, _ = execute(args, dry, parent, rows, csv_names, gen, cards_out)
    finally:
        _API.close()
    if not ok:
        sys.exit(1)
    if dry:
        print("\n(DRY-RUN — nothing was changed. Re-run with --apply to execute.)")


