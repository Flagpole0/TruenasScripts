def ensure_group(name, dry, cache, stats):
    if name in cache:
        return cache[name]
    res = call("group.query", [["group", "=", name]], label=f"query group {name}")
    if res:
        grp = res[0]
        if grp.get("local") is False:
            print(f"  [group {name}] WARNING: exists but is not a local group")
        print(f"  [group {name}] OK (gid {grp.get('gid')})")
    else:
        print(f"  [group {name}] CREATE")
        created = call("group.create", {"name": name, "smb": True},
                       dry=dry, mutate=True, label=f"create group {name}")
        stats["groups_created"] += 1
        if dry:
            grp = {"id": None, "gid": None, "group": name, "_planned": True}
        else:
            gid_lookup = created if isinstance(created, int) else (created or {}).get("id")
            grp = call("group.query", [["id", "=", gid_lookup]])[0]
    cache[name] = grp
    return grp


def _card(row, passphrase, args):
    share = args.share_path.replace("{user}", row["username"]) if args.share_path else ""
    return {"username": row["username"], "full_name": row["full_name"],
            "passphrase": passphrase, "share": share}


def ensure_user(row, group_objs, args, dry, cards, gen, stats):
    """Return (uid, gid) for the folder owner, or (None, None) if unavailable."""
    name = row["username"]
    res = call("user.query", [["username", "=", name]], label=f"query user {name}")
    user = res[0] if res else None

    if user is None:
        if not args.create_users:
            print(f"    -> MISSING user (not created; pass --create-users)")
            stats["users_missing"] += 1
            return None, None
        print(f"    -> CREATE user {name} ({row['full_name']}) with new passphrase")
        passphrase = gen.new()
        payload = {
            "username": name,
            "full_name": row["full_name"],
            "group_create": True,
            "groups": [g["id"] for g in group_objs if g.get("id") is not None],
            "home": "/var/empty",
            "shell": "/usr/sbin/nologin",
            "smb": True,
            "password": passphrase,
        }
        if dry:
            print(f"      [DRY-RUN] user.create "
                  f"{json.dumps({**payload, 'password': '<redacted>'})}")
            created = None
        else:
            created = call("user.create", payload, label=f"create user {name}")
        stats["users_created"] += 1
        cards.append(_card(row, passphrase, args))
        if dry:
            return "<new>", "<new>"
        user_id = created if isinstance(created, int) else created.get("id")
        user = call("user.query", [["id", "=", user_id]])[0]
        return user["uid"], user["group"]["bsdgrp_gid"]

    if user.get("builtin"):
        print(f"    -> SKIP: '{name}' is a builtin system account")
        stats["skipped"] += 1
        return None, None
    if user.get("local") is False:
        print(f"    -> SKIP: '{name}' is a directory-service user, not local")
        stats["skipped"] += 1
        return None, None

    have = list(user.get("groups") or [])
    missing = [g for g in group_objs if g.get("id") is None or g["id"] not in have]
    if missing:
        names = ", ".join(g["group"] for g in missing)
        print(f"    -> ADD to groups: {names}")
        new_ids = have + [g["id"] for g in missing if g.get("id") is not None]
        call("user.update", user["id"], {"groups": new_ids},
             dry=dry, mutate=True, label=f"update groups {name}")
        stats["memberships_added"] += len(missing)
    else:
        print(f"    -> user OK (uid {user['uid']})")

    if args.reset_passwords:
        print(f"    -> RESET password to new passphrase")
        passphrase = gen.new()
        if dry:
            print(f"      [DRY-RUN] user.update {user['id']} "
                  f'{{"password": "<redacted>"}}')
        else:
            call("user.update", user["id"], {"password": passphrase},
                 label=f"reset password {name}")
        stats["passwords_reset"] += 1
        cards.append(_card(row, passphrase, args))
    return user["uid"], user["group"]["bsdgrp_gid"]


# --------------------------------------------------------------------------- #
# Filesystem (via API)
# --------------------------------------------------------------------------- #
def list_entries(path):
    """name -> type ('DIRECTORY', 'FILE', 'SYMLINK', 'OTHER') for one directory."""
    return {e["name"]: e.get("type") for e in call("filesystem.listdir", path, [],
                                                   label=f"list {path}") or []}


def make_dir(path):
    """filesystem.mkdir takes a dict on newer releases and a bare path on older."""
    try:
        call("filesystem.mkdir", {"path": path, "options": {"mode": "700"}},
             label=f"mkdir {path}")
    except ApiError as first:
        try:
            call("filesystem.mkdir", path, label=f"mkdir {path}")
        except ApiError:
            raise first from None


# --------------------------------------------------------------------------- #
# ACLs
# --------------------------------------------------------------------------- #
def ace(tag, perm, flags, id_=None):
    return {"tag": tag, "id": None if tag in SPECIAL_TAGS else id_, "type": "ALLOW",
            "perms": {"BASIC": perm}, "flags": {"BASIC": flags}}


def folder_dacl(admin_gid):
    dacl = [ace("owner@", "FULL_CONTROL", "INHERIT")]
    if admin_gid is not None:
        dacl.append(ace("GROUP", "FULL_CONTROL", "INHERIT", admin_gid))
    return dacl


def parent_dacl(homes_gid, admin_gid):
    dacl = [ace("owner@", "FULL_CONTROL", "NOINHERIT")]
    if homes_gid is not None:
        dacl.append(ace("GROUP", "TRAVERSE", "NOINHERIT", homes_gid))
    if admin_gid is not None:
        dacl.append(ace("GROUP", "FULL_CONTROL", "NOINHERIT", admin_gid))
    return dacl


def norm_ace(a):
    tag = a.get("tag")
    return (tag, None if tag in SPECIAL_TAGS else a.get("id"), a.get("type"),
            json.dumps(a.get("perms"), sort_keys=True),
            json.dumps(a.get("flags"), sort_keys=True))


def acl_drift(current, uid, gid, dacl):
    """Return a list of human-readable differences (empty = in sync)."""
    if current is None:
        return ["no ACL yet"]
    diffs = []
    if current.get("acltype") not in ("NFS4", "NFSV4"):
        diffs.append(f"acltype {current.get('acltype')} -> NFS4")
    if current.get("uid") != uid:
        diffs.append(f"owner uid {current.get('uid')} -> {uid}")
    if current.get("gid") != gid:
        diffs.append(f"owner gid {current.get('gid')} -> {gid}")
    if [norm_ace(a) for a in current.get("acl", [])] != [norm_ace(a) for a in dacl]:
        diffs.append("ACE list differs")
    return diffs


def apply_acl(path, uid, gid, dacl, dry, label):
    payload = {
        "path": path, "dacl": dacl, "uid": uid, "gid": gid, "acltype": "NFS4",
        "options": {"stripacl": False, "recursive": False,
                    "traverse": False, "canonicalize": True},
    }
    call("filesystem.setacl", payload, job=True, dry=dry, mutate=True, label=label)


