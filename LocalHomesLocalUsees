def parse_size(raw, lineno):
    m = SIZE_RE.fullmatch(raw.strip())
    if not m:
        sys.exit(f"ERROR: CSV line {lineno}: bad quota '{raw}' (use e.g. 500G, 1T)")
    return int(float(m.group(1)) * UNITS[m.group(2).upper()])


def load_csv(path):
    rows, seen = [], set()
    with open(path, newline="") as f:
        reader = csv.DictReader(f)
        if not reader.fieldnames or "username" not in reader.fieldnames:
            sys.exit("ERROR: CSV needs a header row with at least a 'username' column.")
        for lineno, row in enumerate(reader, start=2):
            user = (row.get("username") or "").strip()
            if not user or user.startswith("#"):
                continue
            if not USERNAME_RE.fullmatch(user):
                sys.exit(f"ERROR: CSV line {lineno}: invalid username '{user}'")
            if user in seen:
                sys.exit(f"ERROR: CSV line {lineno}: duplicate username '{user}'")
            seen.add(user)

            groups = [g.strip() for g in (row.get("groups") or "").split(";") if g.strip()]
            for g in groups:
                if not GROUPNAME_RE.fullmatch(g):
                    sys.exit(f"ERROR: CSV line {lineno}: invalid group '{g}'")

            quota_raw = (row.get("quota") or "").strip()
            rows.append({
                "username": user,
                "full_name": (row.get("full_name") or "").strip() or user,
                "groups": groups,
                "quota": parse_size(quota_raw, lineno) if quota_raw else None,
            })
    if not rows:
        sys.exit("ERROR: CSV contains no users.")
    return rows


