# --------------------------------------------------------------------------- #
# Minimal WebSocket client (RFC 6455) over TLS — standard library only
# --------------------------------------------------------------------------- #
class HandshakeError(Exception):
    def __init__(self, status, msg):
        super().__init__(msg)
        self.status = status


class WebSocket:
    GUID = b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

    def __init__(self, host, port, path, ctx, timeout):
        raw = socket.create_connection((host, port), timeout=timeout)
        try:
            self.sock = ctx.wrap_socket(raw, server_hostname=host)
        except Exception:
            raw.close()
            raise
        self.buf = b""
        key = base64.b64encode(os.urandom(16))
        host_hdr = host if port == 443 else f"{host}:{port}"
        self.sock.sendall(
            f"GET {path} HTTP/1.1\r\nHost: {host_hdr}\r\nUpgrade: websocket\r\n"
            f"Connection: Upgrade\r\nSec-WebSocket-Key: {key.decode()}\r\n"
            f"Sec-WebSocket-Version: 13\r\n\r\n".encode())
        while b"\r\n\r\n" not in self.buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise HandshakeError(0, "connection closed during handshake")
            self.buf += chunk
            if len(self.buf) > 65536:
                raise HandshakeError(0, "oversized handshake response")
        head, self.buf = self.buf.split(b"\r\n\r\n", 1)
        lines = head.decode("latin-1").split("\r\n")
        parts = lines[0].split(" ", 2)
        status = int(parts[1]) if len(parts) > 1 and parts[1].isdigit() else 0
        if status != 101:
            self.sock.close()
            raise HandshakeError(status, f"HTTP {status} from {path}")
        hdrs = {k.strip().lower(): v.strip()
                for k, v in (l.split(":", 1) for l in lines[1:] if ":" in l)}
        want = base64.b64encode(hashlib.sha1(key + self.GUID).digest()).decode()
        if hdrs.get("sec-websocket-accept") != want:
            self.sock.close()
            raise HandshakeError(status, "bad Sec-WebSocket-Accept")

    def peer_fingerprint(self):
        der = self.sock.getpeercert(binary_form=True)
        return hashlib.sha256(der).hexdigest().upper()

    def _read(self, n):
        while len(self.buf) < n:
            chunk = self.sock.recv(max(65536, n - len(self.buf)))
            if not chunk:
                raise ConnectionError("websocket closed by server")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def _send_frame(self, opcode, payload):
        n = len(payload)
        head = bytes([0x80 | opcode])
        if n < 126:
            head += bytes([0x80 | n])
        elif n < 65536:
            head += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            head += bytes([0x80 | 127]) + struct.pack(">Q", n)
        mask = os.urandom(4)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(head + mask + masked)

    def send_text(self, text):
        self._send_frame(0x1, text.encode())

    def recv_text(self):
        parts = []
        while True:
            b1, b2 = self._read(2)
            fin, opcode = b1 & 0x80, b1 & 0x0F
            n = b2 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            mask = self._read(4) if b2 & 0x80 else None
            data = self._read(n)
            if mask:
                data = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
            if opcode == 0x8:
                raise ConnectionError("websocket closed by server")
            if opcode == 0x9:
                self._send_frame(0xA, data)
                continue
            if opcode == 0xA:
                continue
            parts.append(data)
            if fin:
                return b"".join(parts).decode()

    def close(self):
        try:
            self._send_frame(0x8, struct.pack(">H", 1000))
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass


# --------------------------------------------------------------------------- #
# TrueNAS middleware client
# --------------------------------------------------------------------------- #
class ApiError(Exception):
    def __init__(self, msg, errno=None):
        super().__init__(msg)
        self.errno = errno


def _norm_fp(fp):
    return re.sub(r"[^0-9A-Fa-f]", "", fp or "").upper()


def _fmt_fp(hexfp):
    return ":".join(hexfp[i:i + 2] for i in range(0, len(hexfp), 2))


def tls_context(ca_cert, pinned):
    if pinned:
        # Chain/hostname checks are replaced by an exact certificate pin,
        # verified before anything (including the API key) is sent.
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    else:
        ctx = ssl.create_default_context(cafile=ca_cert)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    return ctx


class TrueNAS:
    ENDPOINTS = {"jsonrpc": "/api/current", "legacy": "/websocket"}

    def __init__(self, host, port, ctx, fingerprint=None, protocol="auto", timeout=30):
        self.host, self.port, self.ctx = host, port, ctx
        self.fingerprint = _norm_fp(fingerprint) if fingerprint else None
        self.timeout = timeout
        self.ids = itertools.count(1)
        order = ["jsonrpc", "legacy"] if protocol == "auto" else [protocol]
        last = None
        for proto in order:
            try:
                self.ws = WebSocket(host, port, self.ENDPOINTS[proto], ctx, timeout)
            except HandshakeError as e:
                last = e
                if protocol == "auto" and e.status in (400, 403, 404, 405):
                    continue
                raise ApiError(f"websocket handshake failed: {e}")
            self.protocol = proto
            break
        else:
            raise ApiError(f"no usable API endpoint on {host}:{port} ({last})")

        if self.fingerprint is not None:
            got = self.ws.peer_fingerprint()
            if got != self.fingerprint:
                self.ws.close()
                raise ApiError("TLS certificate fingerprint MISMATCH — refusing to send "
                               f"credentials.\n  expected {_fmt_fp(self.fingerprint)}\n"
                               f"  got      {_fmt_fp(got)}")

        if self.protocol == "legacy":
            self.ws.send_text(json.dumps({"msg": "connect", "version": "1", "support": ["1"]}))
            while True:
                msg = json.loads(self.ws.recv_text())
                if msg.get("msg") == "connected":
                    break
                if msg.get("msg") == "failed":
                    raise ApiError("legacy API refused the connection")

    def close(self):
        self.ws.close()

    def _rpc(self, method, params):
        n = next(self.ids)
        if self.protocol == "jsonrpc":
            self.ws.send_text(json.dumps({"jsonrpc": "2.0", "id": n,
                                          "method": method, "params": params}))
        else:
            n = str(n)
            self.ws.send_text(json.dumps({"id": n, "msg": "method",
                                          "method": method, "params": params}))
        while True:
            msg = json.loads(self.ws.recv_text())
            if msg.get("id") != n:
                continue  # event/notification or unrelated message
            err = msg.get("error")
            if err:
                if self.protocol == "jsonrpc":
                    data = err.get("data") or {}
                    reason = data.get("reason") or err.get("message")
                    errno = data.get("error")
                else:
                    reason, errno = err.get("reason") or err.get("error"), err.get("error")
                raise ApiError(f"{method}: {reason}", errno if isinstance(errno, int) else None)
            return msg.get("result")

    def call(self, method, *params, job=False):
        result = self._rpc(method, list(params))
        return self._wait_job(result, method) if job else result

    def _wait_job(self, job_id, method, limit=900):
        deadline = time.monotonic() + limit
        while time.monotonic() < deadline:
            jobs = self._rpc("core.get_jobs", [[["id", "=", job_id]]])
            if not jobs:
                raise ApiError(f"{method}: job {job_id} disappeared")
            job = jobs[0]
            state = job.get("state")
            if state == "SUCCESS":
                return job.get("result")
            if state in ("FAILED", "ABORTED"):
                raise ApiError(f"{method}: job {state.lower()}: {job.get('error')}")
            time.sleep(0.5)
        raise ApiError(f"{method}: job {job_id} timed out")

    def login(self, api_key, api_user=None):
        try:
            ok = self._rpc("auth.login_with_api_key", [api_key])
        except ApiError:
            ok = False
        if not ok and api_user:
            res = self._rpc("auth.login_ex", [{"mechanism": "API_KEY_PLAIN",
                                               "username": api_user, "api_key": api_key}])
            ok = isinstance(res, dict) and res.get("response_type") == "SUCCESS"
        if not ok:
            raise ApiError("API key login failed (wrong key, revoked key, or user lacks access)")


_API = None


def call(method, *params, job=False, dry=False, mutate=False, label=""):
    """Call the middleware. Mutating calls are printed, not executed, in
    dry-run. Read-only calls always execute."""
    if dry and mutate:
        shown = " ".join(json.dumps(p) for p in params)
        print(f"      [DRY-RUN] {method} {shown}")
        return None
    try:
        return _API.call(method, *params, job=job)
    except ApiError as e:
        if label:
            raise ApiError(f"{e} ({label})", e.errno) from None
        raise


def read_api_key(args):
    if args.api_key_file:
        try:
            with open(os.path.expanduser(args.api_key_file)) as f:
                key = f.read().strip()
        except OSError as e:
            sys.exit(f"ERROR: cannot read --api-key-file: {e}")
    else:
        key = os.environ.get("TRUENAS_API_KEY", "").strip()
        if not key and sys.stdin.isatty():
            key = getpass.getpass("TrueNAS API key: ").strip()
    if not key:
        sys.exit("ERROR: no API key (set TRUENAS_API_KEY or use --api-key-file).")
    return key


def split_host(raw):
    raw = (raw or "").strip()
    if raw.startswith("["):                       # [ipv6]:port
        host, _, rest = raw[1:].partition("]")
        return host, int(rest[1:]) if rest.startswith(":") else 443
    if raw.count(":") == 1:
        host, port = raw.split(":")
        return host, int(port)
    return raw, 443


